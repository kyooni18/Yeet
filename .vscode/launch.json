{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug yeet",
      "program": "${workspaceFolder}/target/debug/yeet",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo: build yeet"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Release yeet",
      "program": "${workspaceFolder}/target/release/yeet",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo: build release yeet"
    }
  ]
}
