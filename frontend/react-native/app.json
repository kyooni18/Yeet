{
  "expo": {
    "name": "Yeet",
    "slug": "yeet",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.yeet.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "dev.yeet.app"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router"
    ],
    "scheme": "yeet"
  }
}
