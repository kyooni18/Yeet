{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yeet",
  "version": "0.1.0",
  "identifier": "com.yeet.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:dev",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run prepare:build",
    "frontendDist": "../../react-native/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Yeet", "width": 1280, "height": 850, "minWidth": 640, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"], "resources": { "runtime/": "runtime/" } }
}
