OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Jev backend: typesafe (default) or openrouter
# JEV_PROVIDER=openrouter
# Jev model override: jev-latest for TypeSafe, ~typesafe/jev-latest for OpenRouter
# JEV_MODEL=~typesafe/jev-latest
# Optional OpenRouter attribution headers
# OPENROUTER_APP_URL=https://your.app
# OPENROUTER_APP_NAME=Yeet

# Optional runtime overrides
# YEET_NODE=/opt/homebrew/bin/node
# YEET_CONFIG_DIR=/path/to/config

# Optional Gemini Code Assist project override for browser OAuth
# GEMINI_PROJECT_ID=
