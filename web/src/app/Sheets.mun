import { Icon, Transition } from "@mun/core"
import { ActionButton, Segmented } from "./Common.mun"
import { workIcon } from "./workIcons"
import { SheetBlur } from "./Blur.mun"
import { remoteStore } from "@/store/remoteStore"
import { color, mono } from "./theme"
import { remote, sheet, spring, connected, openSheet, shortModel, settingsEditorValue } from "./state"
import { FeatureSheet, sheetTitle } from "./FeatureSheets.mun"
import { modalRef } from "./modal"

const modelQuery = State("")

function filteredModels() {
  const needle = modelQuery.value.trim().toLowerCase()
  const catalog = remote.value.state.model_catalog.length
    ? remote.value.state.model_catalog
    : remote.value.state.available_models.map(id => ({ id, provider: id.split("/")[0], model: id }))
  return needle ? catalog.filter(item => item.id.toLowerCase().includes(needle)) : catalog
}

function chooseModel(id: string) {
  remoteStore.selectModel(id)
  openSheet("none")
}

struct ListRow: View {
  let title: String
  let detail: String
  let selected: Bool
  let action: () => void
  @State var hovering: Bool = false
  var body: some View {
    Button(action: action, label: {
      HStack(spacing: 10) {
        Text(title).lineLimit(1).style({ minWidth: "0", flex: "1" })
        Text(detail).fontSize(12).foregroundStyle(color.faint).lineLimit(1).style({ maxWidth: "35%" })
        Group() {
          if selected {
            Icon(workIcon("check"), { width: 14, height: 14 })
          }
        }.frame(width: 14)
      }.style({ width: "100%" })
    })
    .withProps({ className: "model-row", "aria-pressed": selected, title: title + (detail ? " · " + detail : "") })
    .padding({ top: 9, bottom: 9, leading: 10, trailing: 10 })
    .background(hovering.value ? color.hover : "transparent")
    .style({ borderRadius: "var(--r-inline)" })
    .onHover(inside => { hovering.value = inside })
  }
}

struct ModelSheet: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 8) {
      TextField(Binding(modelQuery), "Search models")
        .accessibilityLabel("Search models")
        .withProps({ className: "model-search", type: "search" })
        .padding({ top: 8, bottom: 8, leading: 10, trailing: 10 })
        .background(color.raised)
        .style({ border: "0", outline: "none", borderRadius: "var(--r-control)", font: "inherit", color: "inherit" })
      if remote.value.state.is_loading_models {
        Text("Loading models…").fontSize(12).foregroundStyle(color.muted)
      }
      ScrollView() {
        VStack(alignment: .stretch, spacing: 1) {
          ForEach(filteredModels(), { id: item => item.id }) { item in
            ListRow(title: shortModel(item.model || item.id), detail: item.provider === item.id ? "" : item.provider, selected: item.id === remote.value.state.active_model, action: { chooseModel(item.id) })
              .disabled(!connected())
          }
        }.style({ width: "100%", minWidth: "0" })
      }
      .style({ maxHeight: "min(420px, calc(var(--app-height, 100dvh) - 180px))", minHeight: "0", width: "100%" })
    }
    .style({ minHeight: "0", width: "100%" })
  }
}

struct Switch: View {
  let on: Bool
  var body: some View {
    HStack(spacing: 0) {
      Circle()
        .frame(width: 16, height: 16)
        .style({ borderRadius: "50%", flex: "none" })
        .background(on ? color.accentInk : color.muted)
        .offset(on ? 14 : 0, 0)
        .animation(spring, value: on)
      Spacer()
    }
    .padding(2)
    .background(on ? color.accent : color.raised)
    .animation(spring, value: on)
    .style({ width: "34px", height: "20px", borderRadius: "999px", flex: "none" })
  }
}

/** A line under a setting's name is kept only when it explains why the control is
 * unavailable or reports live state (web-search status and setup); descriptions of what
 * a control does are not shown. */
function selectedOption(control: Any): string {
  return control.options.find(option => option.selected)?.value ?? ""
}

function chooseOption(control: Any, value: string) {
  const option = control.options.find(item => item.value === value)
  if (option) remoteStore.sendSettingsUi(option.action)
}

function showsDetail(control: Any): boolean {
  return !!control.detail && (!control.enabled || String(control.id).startsWith("web_"))
}

struct SettingControl: View {
  let control: Any
  let section: String
  var body: some View {
    VStack(alignment: .stretch, spacing: 6) {
      if control.kind === "choice" {
        // A choice that repeats its section's name needs no second label.
        if control.label !== section {
          Text(control.label).fontSize(13)
        }
        Segmented(label: control.label, options: control.options, value: selectedOption(control), onChange: value => { chooseOption(control, value) }, enabled: connected() && control.enabled)
      } else {
        Button(action: { remoteStore.sendSettingsUi(control.action) }, label: {
          HStack(spacing: 10) {
            VStack(alignment: .stretch, spacing: 1) {
              Text(control.label).fontSize(13)
              if showsDetail(control) {
                Text(control.detail).fontSize(12).foregroundStyle(color.muted)
              }
            }
            .style({ flex: "1", minWidth: "0", overflowWrap: "anywhere" })
            Spacer()
            if control.kind === "toggle" {
              Switch(on: !!control.checked)
            } else {
              if control.action_label {
                Text(control.action_label)
                  .lineLimit(1)
                  .fontSize(12)
                  .foregroundStyle(color.text)
                  .padding({ top: 4, bottom: 4, leading: 12, trailing: 12 })
                  .background(LinearGradient(colors: [Color(color.btnTop), Color(color.btnBottom)], startPoint: .top, endPoint: .bottom))
                  .border(color.btnEdge, 1)
                  .cornerRadius(8)
                  .shadow(color.btnDrop, 6, 0, 2)
                  .style({ flex: "none" })
              } else {
                Text(control.value || "›")
                  .lineLimit(1)
                  .fontSize(12)
                  .foregroundStyle(color.muted)
                  .style({ flex: "none", maxWidth: "40%", overflow: "hidden", textOverflow: "ellipsis" })
              }
            }
          }
        })
        .withProps({ className: "setting-row", role: control.kind === "toggle" ? "switch" : "button", "aria-label": control.label, "aria-checked": control.kind === "toggle" ? !!control.checked : undefined })
        .disabled(!connected() || !control.enabled)
      }
    }
    .style({ width: "100%", minWidth: "0" })
  }
}

struct SettingsEditor: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 6) {
      Text(remote.value.settings?.editor?.label || "Setting").fontSize(13)
      HStack(spacing: 6) {
        TextField(Binding(settingsEditorValue), remote.value.settings?.editor?.label || "Setting")
          .accessibilityLabel(remote.value.settings?.editor?.label || "Setting")
          .padding({ top: 6, bottom: 6, leading: 8, trailing: 8 })
          .background(color.raised)
          .style({ flex: "1", minWidth: "0" })
          .style({ border: "0", outline: "none", borderRadius: "var(--r-inline)", font: "inherit", color: "inherit" })
        Button("Save") { remoteStore.sendSettingsUi({ type: "submit_editor", value: settingsEditorValue.value }) }
          .disabled(!connected() || remote.value.settings.working)
        Button("Cancel") { remoteStore.sendSettingsUi({ type: "cancel_editor" }) }.foregroundStyle(color.muted)
      }
    }
    .style({ width: "100%", minWidth: "0" })
    .transition(Transition.opacity)
  }
}

struct SettingsSheet: View {
  var body: some View {
    ScrollView() {
      VStack(alignment: .stretch, spacing: 18) {
        if remote.value.settings?.notice {
          Text(remote.value.settings.notice).fontSize(12).foregroundStyle(color.muted)
        }
        if remote.value.settings?.editor {
          SettingsEditor()
        }
        ForEach(remote.value.settings?.sections ?? [], { id: section => section.id }) { section in
          VStack(alignment: .stretch, spacing: 2) {
            Text(section.label).withProps({ className: "section-label setting-section" })
            ForEach(section.controls, { id: control => control.id }) { control in
              SettingControl(control: control, section: section.label)
            }
          }.style({ width: "100%", minWidth: "0" })
        }
      }.style({ width: "100%", minWidth: "0" })
    }
    .withProps({ className: "sheet-scroll" })
    .style({ minHeight: "0", flex: "1 1 auto" })
  }
}

export struct SheetLayer: View {
  var body: some View {
    ZStack(alignment: .center) {
      Rectangle()
        .style({ position: "absolute", inset: "0", background: "var(--scrim)" })
        .onTapGesture(() => openSheet("none"))
        .transition(Transition.opacity)
      VStack(alignment: .stretch, spacing: 12) {
        HStack(spacing: 0) {
          Text(sheetTitle()).style({ fontWeight: "var(--w-emphasis)" })
          Spacer()
          ActionButton(title: "Done", kind: "secondary", small: false, enabled: true, action: () => { openSheet("none") })
        }
        if sheet.value === "model" {
          ModelSheet()
        } else if sheet.value === "settings" {
          SettingsSheet()
        } else {
          FeatureSheet().id(sheet.value)
        }
      }
      .withProps({ role: "dialog", "aria-modal": "true", "aria-label": sheetTitle(), "data-sheet-dialog": "true", className: "sheet-dialog", ref: modalRef, tabindex: "-1" })
      .padding(16)
      .style({ width: "480px", maxHeight: "calc(var(--app-height, 100dvh) - 32px)", minHeight: "0" })
      .background(color.panel)
      .shadow("rgba(0, 0, 0, 0.18)", 24, 0, 8)
      .style({ borderRadius: "var(--r-surface)", maxWidth: "calc(100vw - 24px)", position: "relative" })
      .transition(Transition.opacity.combined(Transition.scale(0.94)).combined(Transition.move("bottom", 14)))
    }
    .style({ position: "fixed", inset: "0", width: "100%", height: "100%", zIndex: "var(--z-sheet)" })
  }
}
