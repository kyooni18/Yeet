import { Transition } from "@mun/core"
import { remoteStore } from "@/store/remoteStore"
import { color } from "./theme"
import { Spinner, PrimaryButton, PageHeader } from "./Common.mun"
import { remote, ease, connected, openSheet } from "./state"

const objective = State("")
let handledEffect = -1
remoteStore.subscribe(() => {
  const pending = remoteStore.getSnapshot().agentEffect
  if (!pending || pending.revision === handledEffect) return
  handledEffect = pending.revision
  const effect = remoteStore.consumeAgentEffect(pending.revision)
  if (effect?.open_group_settings) openSheet("agent-settings")
  if (effect?.submitted_text === objective.value.trim()) objective.value = ""
})

function toneColor(tone: string): string {
  if (tone === "active") return color.accent
  if (tone === "error") return color.del
  if (tone === "complete") return color.add
  return color.faint
}

function submitObjective() {
  const value = objective.value.trim()
  if (!value) return
  remoteStore.sendAgentUi({ type: "submit_draft", value })
}

struct AgentButton: View {
  let control: Any
  var body: some View {
    Button(control.label) { remoteStore.sendAgentUi(control.action) }
      .fontSize(12)
      .padding({ top: 5, bottom: 5, leading: 10, trailing: 10 })
      .background(color.raised)
      .style({ borderRadius: "6px" })
      .disabled(!control.enabled || !connected())
  }
}

struct Member: View {
  let row: Any
  var body: some View {
    Button(action: { remoteStore.sendAgentUi(row.select_action) }, label: {
      HStack(spacing: 10) {
        if row.status.tone === "active" {
          Spinner()
        } else {
          Circle().frame(width: 7, height: 7)
            .style({ borderRadius: "50%", flex: "none", margin: "0 1px" }).background(toneColor(row.status.tone))
        }
        VStack(alignment: .stretch, spacing: 1) {
          Text(row.member.role || row.member.id).fontSize(13)
          Text(row.member.summary || row.member.description).fontSize(12).foregroundStyle(color.muted).lineLimit(2)
        }
        Spacer()
        Text(row.status.label).fontSize(12).foregroundStyle(color.faint)
      }
    })
    .padding({ top: 8, bottom: 8, leading: 10, trailing: 10 })
    .background(row.selected ? color.rowSelect : "transparent")
    .style({ borderRadius: "10px" })
    .animation(ease, value: row.selected)
  }
}

struct Feed: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      Text("Activity").fontSize(12).foregroundStyle(color.faint)
      ForEach(remote.value.agents.feed.slice(-40).reverse(), { id: event => event.id }) { event in
        HStack(alignment: .top, spacing: 10) {
          Text(event.actor).fontSize(12).foregroundStyle(color.muted).frame(width: 96, alignment: "leading").lineLimit(1)
          Text(event.detail).fontSize(12).style({ width: "100%" })
        }
        .transition(Transition.opacity)
      }
    }
  }
}

struct AgentsContent: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 20) {
      HStack(spacing: 10) {
        PageHeader(title: remote.value.agents.headline || remote.value.agents.title, subtitle: remote.value.agents.group_status.label)
      }
      HStack(spacing: 8) {
        AgentButton(control: remote.value.agents.create_control)
        AgentButton(control: remote.value.agents.settings_control)
        ForEach(remote.value.agents.group_controls.filter(control => control.visible), { id: control => control.label }) { control in
          AgentButton(control: control)
        }
      }.withProps({ className: "feature-actions" })
      if remote.value.agents.state.creating_group || remote.value.agents.state.input_focused {
        VStack(alignment: .stretch, spacing: 8) {
        TextField(Binding(objective), remote.value.agents.state.creating_group ? remote.value.agents.create_hint : remote.value.agents.composer_hint)
          .accessibilityLabel(remote.value.agents.state.creating_group ? "Group objective" : "Agent message")
          .withProps({ onKeyDown: event => { if (event.key === "Enter") submitObjective() } })
          .withProps({ className: "form-field" })
        HStack(spacing: 8) {
          PrimaryButton(title: remote.value.agents.state.creating_group ? "Create group" : "Send message", enabled: !!objective.value.trim() && connected(), action: { submitObjective() })
          if remote.value.agents.state.creating_group {
            Button("Cancel") { remoteStore.sendAgentUi({ type: "cancel_draft" }) }.withProps({ className: "form-action" })
          }
        }
        }
      }
      if remote.value.agents.group.objective {
        Text(remote.value.agents.group.objective).foregroundStyle(color.muted)
      }
      if remote.value.agents.result {
        Element("yeet-markdown", { source: remote.value.agents.result })
      }
      if remote.value.agents.members.length {
        VStack(alignment: .stretch, spacing: 2) {
          ForEach(remote.value.agents.members, { id: row => row.member.id }) { row in
            Member(row: row)
          }
        }
      } else {
        VStack(alignment: .stretch, spacing: 4) {
          Text(remote.value.agents.empty_title).foregroundStyle(color.muted)
          Text(remote.value.agents.empty_message).fontSize(12).foregroundStyle(color.faint)
        }
      }
      if remote.value.agents.feed.length {
        Feed()
      }
      HStack(spacing: 8) {
        ForEach(remote.value.agents.selection_controls.filter(control => control.visible), { id: control => control.label }) { control in
          AgentButton(control: control)
        }
      }.withProps({ className: "feature-actions" })
      if remote.value.agents.findings.length {
        VStack(alignment: .stretch, spacing: 10) {
          Text("Shared findings").fontSize(13).fontWeight("medium")
          ForEach(remote.value.agents.findings, { id: item => item.member_id + ":" + item.task_id + ":" + item.at }) { item in
            VStack(alignment: .stretch, spacing: 4) {
              Text(item.actor).fontSize(12).foregroundStyle(color.muted)
              Element("yeet-markdown", { source: item.summary })
            }
          }
        }
      }
    }
  }
}

export struct AgentsPage: View {
  var body: some View {
    ScrollView() {
      VStack(alignment: .stretch, spacing: 0) {
        if remote.value.agents {
          AgentsContent()
        } else {
          Text("Agents are not available on this connection.").foregroundStyle(color.muted)
        }
      }
      .withProps({ className: "feature-page" })
    }
    .style({ flex: "1", minHeight: "0", width: "100%" })
  }
}
