import { Icon, Transition } from "@mun/core"
import { remoteStore } from "@/store/remoteStore"
import { color, mono } from "./theme"
import { workspaceFiles, workspaceChanges, ease, displayPath, workspaceLine, openPage, connected } from "./state"
import { workIcon } from "./workIcons"
import { onCodeKeyDown, unifiedRows } from "./toolPresentation"
import { PageHeader, Chip } from "./Common.mun"

function size(bytes: number): string {
  if (bytes < 1024) return bytes + " B"
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + " KB"
  return (bytes / 1048576).toFixed(1) + " MB"
}

function modified(seconds: number | null): string {
  if (!seconds) return ""
  const date = new Date(seconds * 1000)
  const today = new Date()
  if (date.toDateString() === today.toDateString()) return "Modified today"
  return date.toLocaleDateString(undefined, { month: "short", day: "numeric" })
}

function changeTotals(): string {
  const files = workspaceChanges.value?.files ?? []
  const added = files.reduce((sum, file) => sum + (file.added ?? 0), 0)
  const removed = files.reduce((sum, file) => sum + (file.removed ?? 0), 0)
  return files.length + (files.length === 1 ? " file" : " files") + " · +" + added + " −" + removed
}

/** Mockup list row: 38pt, 10pt radius, beige hover and selection. */
struct ListRow: View {
  let title: String
  let detail: String
  let selected: Bool
  let mono: Bool
  let icon: String
  let action: () => void
  @State var hovering: Bool = false
  var body: some View {
    Button(action: action, label: {
      HStack(spacing: 8) {
        Icon(workIcon(icon), { width: 15, height: 15 }).foregroundStyle(color.muted).style({ flex: "none" })
        Text(title).fontSize(mono ? 13 : 15).lineLimit(1).style({ fontFamily: mono ? "var(--mono)" : "inherit", minWidth: "0" })
        Spacer()
        Text(detail).fontSize(13).foregroundStyle(color.faint).style({ whiteSpace: "nowrap" })
      }
    })
    .padding({ top: 9, bottom: 9, leading: 12, trailing: 12 })
    .background(selected ? color.rowSelect : hovering.value ? color.rowHover : "transparent")
    .withProps({ className: "resource-row", title, "aria-pressed": selected })
    .disabled(!connected())
    .style({ borderRadius: "6px", width: "100%", minWidth: "0" })
    .animation(ease, value: hovering.value || selected)
    .onHover(inside => { hovering.value = inside })
  }
}

struct FileInfo: View {
  let info: Any
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      Text(info.name).fontSize(15).fontWeight("medium")
      Text([size(info.size), info.lines != null ? info.lines + " lines" : "", modified(info.modified), info.permissions || "", info.status ? "Changed" : ""].filter(Boolean).join(" · "))
        .fontSize(13)
        .foregroundStyle(color.faint)
      if info.status {
        HStack(spacing: 0) {
          Chip(title: "Review changes", action: { remoteStore.requestChanges(info.path, false); openPage("diff") })
          Spacer()
        }
        .style({ marginLeft: "-8px" })
      }
    }
    .padding({ top: 8, bottom: 16 })
    .transition(Transition.opacity.combined(Transition.move("top", 6)))
  }
}

export struct SourcePreview: View {
  let info: Any
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      if info.preview?.lines.length {
        Element("div", { className: "tool-code-scroll file-source", tabindex: "0", role: "region", "aria-label": "File content for " + info.path, onKeyDown: onCodeKeyDown }) {
          ForEach(info.preview.lines.map((text, index) => ({ text, number: index + 1 })), { id: line => line.number }) { line in
            Element("div", { className: "tool-source__line" }) {
              Text(line.number).withProps({ className: "tool-line-number" })
              Text(line.text || " ").withProps({ className: "tool-code" })
            }
          }
        }
      } else {
        Text(info.preview?.message || (info.preview ? "Empty file" : "File preview not provided by this server")).withProps({ className: "tool-notice" })
      }
      if info.preview?.truncated {
        Text("Preview · first " + info.preview.lines.length + " lines (up to 256 KB). Content continues beyond this preview.").withProps({ className: "tool-notice" })
      }
    }.style({ flex: "1", minHeight: "0", minWidth: "0", width: "100%" })
  }
}

export struct FilesPage: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      HStack(spacing: 8) {
        PageHeader(title: "Files", subtitle: displayPath(workspaceFiles.value?.root) + (workspaceFiles.value?.path ? "/" + workspaceFiles.value.path : ""))
        if workspaceFiles.value?.parent !== null && workspaceFiles.value?.parent !== undefined {
          Chip(title: "Up", action: { remoteStore.requestFiles(workspaceFiles.value.parent) })
        }
      }.withProps({ className: "resource-header" })
      HStack(alignment: .stretch, spacing: 0) {
        ScrollView() {
          VStack(alignment: .stretch, spacing: 2) {
            ForEach(workspaceFiles.value?.entries ?? [], { id: entry => entry.path }) { entry in
              ListRow(title: entry.name, detail: entry.directory ? "›" : entry.status ? entry.status.trim() : "", selected: entry.path === workspaceFiles.value.selected, mono: true, icon: entry.directory ? "folder" : "file", action: { entry.directory ? remoteStore.requestFiles(entry.path) : remoteStore.requestFiles(workspaceFiles.value.path, entry.path) })
            }
            if !workspaceFiles.value?.entries.length {
              Text(workspaceFiles.value ? "Empty folder" : connected() ? "Loading files…" : "Files unavailable offline").withProps({ className: "tool-notice" })
            }
          }.padding(8)
        }.withProps({ className: "file-tree", role: "region", "aria-label": "Directory contents", tabindex: "0" })
        VStack(alignment: .stretch, spacing: 0) {
          if workspaceFiles.value?.info {
            FileInfo(info: workspaceFiles.value.info).padding({ leading: 16, trailing: 16 })
            SourcePreview(info: workspaceFiles.value.info)
          } else {
            Text("Select a file to preview its content").withProps({ className: "resource-empty" })
          }
        }.withProps({ className: "file-preview" }).style({ flex: "1", minWidth: "0", minHeight: "0" })
      }.withProps({ className: "files-layout" }).style({ flex: "1", minWidth: "0", minHeight: "0" })
    }.style({ flex: "1", minHeight: "0", width: "100%" })
  }
}

export struct Patch: View {
  var body: some View {
    Element("div", { className: "workspace-patch", tabindex: "0", role: "region", "aria-label": "Changes for " + (workspaceChanges.value?.selected || "file"), onKeyDown: onCodeKeyDown }) {
      VStack(alignment: .stretch, spacing: 0) {
        Text(workspaceChanges.value?.selected || "").withProps({ className: "patch-path" })
        ForEach(unifiedRows(workspaceChanges.value?.patch ?? []), { id: row => row.index }) { row in
          Element("div", { className: "tool-diff__line tool-diff__line--" + row.kind }) {
            Text(row.old ?? "").withProps({ className: "tool-line-number", "aria-hidden": "true" })
            Text(row.new ?? "").withProps({ className: "tool-line-number", "aria-hidden": "true" })
            Text(row.sign).withProps({ className: "tool-diff__sign" })
            Text(row.text || " ").withProps({ className: "tool-code" })
          }
        }
      }
    }.style({ flex: "1", minWidth: "0", minHeight: "0", overflow: "auto" })
  }
}

export struct DiffPage: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 16) {
      HStack(spacing: 8) {
        PageHeader(title: "Review changes", subtitle: workspaceChanges.value ? changeTotals() : workspaceLine())
        if workspaceChanges.value?.selected {
          Chip(title: workspaceChanges.value.full ? "Changes only" : "Full file", action: {
            remoteStore.requestChanges(workspaceChanges.value.selected, !workspaceChanges.value.full)
          })
        }
      }
      .padding({ leading: 32, trailing: 32 })
      if workspaceChanges.value?.message {
        Text(workspaceChanges.value.message).foregroundStyle(color.faint).padding({ leading: 32 })
      }
      HStack(alignment: .stretch, spacing: 0) {
        ScrollView() {
          VStack(alignment: .stretch, spacing: 2) {
            ForEach(workspaceChanges.value?.files ?? [], { id: file => file.path }) { file in
              ListRow(
                title: file.path,
                detail: file.added === null ? file.status : "+" + file.added + " −" + file.removed,
                selected: file.path === workspaceChanges.value.selected,
                mono: true, icon: "file",
                action: { remoteStore.requestChanges(file.path, workspaceChanges.value.full) }
              )
              .accessibilityLabel(file.path)
            }
          }
        }
        .withProps({ className: "diff-files" })
        .style({ width: "180px", flex: "none" })
        if workspaceChanges.value?.patch.length {
          Patch()
        } else {
          Text(workspaceChanges.value?.files.length ? "Select a changed file to review" : "No uncommitted changes").withProps({ className: "resource-empty" })
        }
      }
      .withProps({ className: "diff-layout" })
      .style({ flex: "1", minHeight: "0" })
    }
    .padding({ top: 20 })
    .style({ flex: "1", minHeight: "0", width: "100%" })
  }
}
