import { key, error, status, loading, busy, enrolling, authorize, loadStatus, authRef } from "./authState"
import { color } from "./theme"

export struct AuthView: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      VStack(alignment: .stretch, spacing: 12) {
        Text(enrolling ? "Register a passkey" : "Authorization required")
          .withProps({ role: "heading", "aria-level": 1 }).fontSize(20).fontWeight("semibold")
        if loading.value {
          Text("Loading authentication methods…")
            .withProps({ role: "status", "aria-label": "Loading authentication methods" })
        } else if !status.value {
          Text(enrolling ? "Yeet Remote could not verify this enrollment link." : "Yeet Remote could not load authentication methods.")
          Button("Retry") { loadStatus() }.withProps({ className: "auth-action" })
        } else if enrolling {
          Text(status.value.enrollmentValid ? "This enrollment was authorized from the local Yeet terminal." : "This enrollment link is invalid or has expired.")
          if status.value.enrollmentValid {
            Button("Register this device's passkey") { authorize("enroll") }
              .withProps({ className: "auth-action auth-primary" }).disabled(busy.value)
          }
        } else {
          if status.value.key {
            Text("Enter the access key printed by `yeet remote`.").foregroundStyle(color.muted)
            TextField(Binding(key), "Access key")
              .withProps({ type: "password", "aria-label": "Access key", autocomplete: "current-password", className: "auth-input", onKeyDown: event => { if (event.key === "Enter") authorize("key") } })
              .disabled(busy.value)
            Button("Authorize") { authorize("key") }
              .withProps({ className: "auth-action auth-primary" }).disabled(busy.value || !key.value.trim())
          }
          if status.value.passkey {
            Button("Use passkey") { authorize("passkey") }
              .withProps({ className: "auth-action" }).disabled(busy.value)
          }
          if !status.value.key && !status.value.passkey {
            Text("No sign-in methods are available. Check the local Yeet terminal.")
          }
        }
        if error.value {
          Text(error.value).withProps({ role: "alert" }).foregroundStyle(color.del)
        }
      }
      .padding(20)
      .withProps({ className: "auth-card" })
      .style({ width: "100%", maxWidth: "420px", margin: "auto", flexShrink: 0 })
    }
    .withProps({ role: "dialog", "aria-modal": "true", "aria-label": enrolling ? "Register a passkey" : "Authorization required", tabindex: -1, ref: authRef })
    .style({ height: "var(--app-height, 100dvh)", overflowY: "auto", padding: "16px", color: "var(--text)", background: "var(--bg)" })
  }
}
