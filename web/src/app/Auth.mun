import { Transition } from "@mun/core"
import { loginWithAccessKey, loginWithPasskey, registerPasskey } from "@/remote/auth"
import { remoteStore } from "@/store/remoteStore"
import { color } from "./theme"

const key = State("")
const error = State("")

async function submitKey() {
  error.value = ""
  try { await loginWithAccessKey(key.value.trim()); key.value = ""; remoteStore.reconnectAfterAuth() }
  catch (failure) { error.value = failure instanceof Error ? failure.message : String(failure) }
}

async function usePasskey() {
  error.value = ""
  try { await loginWithPasskey(); remoteStore.reconnectAfterAuth() }
  catch (failure) { error.value = failure instanceof Error ? failure.message : String(failure) }
}

const params = new URLSearchParams(location.search)
const enrollToken = location.pathname === "/enroll" ? params.get("token") || params.get("enroll") : null

async function enroll() {
  error.value = ""
  try { await registerPasskey(enrollToken); location.replace("/") }
  catch (failure) {
    // Already registered on this device: sign in with it instead.
    if (failure?.name === "InvalidStateError") {
      try { await loginWithPasskey(enrollToken); location.replace("/"); return } catch (again) { failure = again }
    }
    error.value = failure instanceof Error ? failure.message : String(failure)
  }
}

export struct AuthView: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 12) {
      Text("Yeet").fontSize(20).fontWeight("semibold")
      Text("Enter the access key printed by `yeet remote`, or use a passkey.").foregroundStyle(color.muted)
      TextField(Binding(key), "Access key")
        .withProps({ type: "password", autocomplete: "current-password", onKeyDown: event => { if (event.key === "Enter") submitKey() } })
        .padding({ top: 10, bottom: 10, leading: 12, trailing: 12 })
        .background(color.panel)
        .style({ border: "1px solid var(--line)", outline: "none", borderRadius: "8px", font: "inherit", color: "inherit" })
      if enrollToken {
        Button("Register this device's passkey") { enroll() }
          .padding(10)
          .background(color.accent)
          .foregroundStyle(color.accentInk)
          .style({ borderRadius: "8px", textAlign: "center" })
      }
      HStack(spacing: 8) {
        Button("Sign in") { submitKey() }
          .padding({ top: 8, bottom: 8, leading: 16, trailing: 16 })
          .background(color.accent)
          .foregroundStyle(color.accentInk)
          .style({ borderRadius: "8px" })
          .disabled(!key.value.trim())
        Button("Use passkey") { usePasskey() }
          .padding({ top: 8, bottom: 8, leading: 16, trailing: 16 })
          .background(color.raised)
          .style({ borderRadius: "8px" })
      }
      if error.value {
        Text(error.value).foregroundStyle(color.del).transition(Transition.opacity)
      }
    }
    .padding(20)
    .style({ maxWidth: "380px" })
    .style({ margin: "18vh auto 0" })
  }
}
