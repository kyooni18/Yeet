import { Transition, withAnimation } from "@mun/core"
import { remoteStore } from "@/store/remoteStore"
import { color } from "./theme"
import {
  remote, page, workspaceMenu, isWide, ease, connected, openPage, openSheet, newSession, openSession,
  chooseWorkspace, workspaces, toggleSidebar, age,
} from "./state"

/** A full-width sidebar row with hover and selection feedback. */
struct SidebarRow: View {
  let title: String
  let detail: String
  let selected: Bool
  let running: Bool
  let action: () => void
  @State var hovering: Bool = false

  var body: some View {
    Button(action: action, label: {
      HStack(spacing: 8) {
        Text(title)
          .lineLimit(1)
          .foregroundStyle(selected ? color.text : color.muted)
        Spacer()
        if running {
          Circle()
            .frame(width: 6, height: 6)
        .style({ borderRadius: "50%", flex: "none" })
            .background(color.run)
            .transition(Transition.opacity)
        }
        Text(detail)
          .fontSize(12)
          .foregroundStyle(color.faint)
      }
    })
    .padding({ top: 6, bottom: 6, leading: 10, trailing: 10 })
    .background(selected ? color.select : hovering.value ? color.hover : "transparent")
    .style({ borderRadius: "6px" })
    .animation(ease, value: hovering.value)
    .onHover(inside => { hovering.value = inside })
  }
}

struct WorkspaceMenu: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      ForEach(workspaces(), { id: item => item.id }) { item in
        SidebarRow(title: item.label, detail: "", selected: item.selected, running: false, action: { chooseWorkspace(item.path, item.id) })
      }
    }
    .padding({ top: 4, bottom: 8 })
    .transition(Transition.opacity.combined(Transition.move("top", 8)))
  }
}

struct WorkspaceHeader: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      Button(action: { withAnimation(ease) { workspaceMenu.value = !workspaceMenu.value } }, label: {
        HStack(spacing: 6) {
          Text(remote.value.currentWorkspace?.display_name || remote.value.state.workspace_root || "Workspace")
            .fontWeight("semibold")
            .lineLimit(1)
          Text("⌄")
            .foregroundStyle(color.faint)
            .rotationEffect(workspaceMenu.value ? 180 : 0)
            .animation(ease, value: workspaceMenu.value)
          Spacer()
        }
      })
      .padding({ top: 4, bottom: 10, leading: 10, trailing: 10 })
      .disabled(!connected())
      if workspaceMenu.value {
        WorkspaceMenu()
      }
    }
  }
}

struct Navigation: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      SidebarRow(title: "Chat", detail: "", selected: page.value === "chat", running: false, action: { openPage("chat") })
      SidebarRow(title: "Files", detail: "", selected: page.value === "files", running: false, action: { openPage("files") })
      SidebarRow(title: "Changes", detail: "", selected: page.value === "diff", running: false, action: { openPage("diff") })
      SidebarRow(title: "Agents", detail: remote.value.agents?.active_count ? String(remote.value.agents.active_count) : "", selected: page.value === "agents", running: false, action: { openPage("agents") })
    }
  }
}

struct SessionList: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      HStack(spacing: 0) {
        Text("Sessions")
          .fontSize(12)
          .foregroundStyle(color.faint)
        Spacer()
        Button("New") { newSession() }
          .fontSize(12)
          .foregroundStyle(color.muted)
          .disabled(!connected())
      }
      .padding({ top: 16, bottom: 6, leading: 10, trailing: 10 })
      ScrollView() {
        VStack(alignment: .stretch, spacing: 2) {
          ForEach(remote.value.currentWorkspaceSessions, { id: session => session.id }) { session in
            SidebarRow(
              title: session.title || "Untitled",
              detail: age(session.updated_at),
              selected: session.id === remote.value.state.current_session_id,
              running: session.id === remote.value.state.current_session_id && remote.value.state.is_streaming,
              action: { openSession(session.id) }
            )
            .disabled(!connected())
          }
        }
      }
      .style({ flex: "1", minHeight: "0" })
    }
    .style({ flex: "1", minHeight: "0" })
  }
}

struct Footer: View {
  var body: some View {
    HStack(spacing: 8) {
      Circle()
        .frame(width: 7, height: 7)
        .style({ borderRadius: "50%", flex: "none" })
        .background(connected() ? color.add : color.faint)
        .animation(ease, value: connected())
      Text(connected() ? "Connected" : remote.value.connection)
        .fontSize(12)
        .foregroundStyle(color.muted)
      Spacer()
      Button("Settings") { openSheet("settings") }
        .fontSize(12)
        .foregroundStyle(color.muted)
    }
    .padding({ top: 10, leading: 10, trailing: 10 })
  }
}

export struct Sidebar: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      WorkspaceHeader()
      Navigation()
      SessionList()
      Footer()
    }
    .padding(10)
    .style({ width: "260px", height: "100%", position: isWide.value ? "relative" : "fixed", top: "0", left: "0", zIndex: "10" })
    .background(color.panel)
    .style({ borderRight: "1px solid var(--line)", flex: "none" })
  }
}

/** Dims the conversation behind the sidebar on narrow screens. */
export struct Scrim: View {
  var body: some View {
    Rectangle()
      .style({ position: "fixed", inset: "0", zIndex: "9", background: "var(--scrim)" })
      .onTapGesture(() => toggleSidebar(false))
      .transition(Transition.opacity)
  }
}
