import { Icon, Transition, withAnimation } from "@mun/core"
import { DrawerBlur } from "./Blur.mun"
import { color } from "./theme"
import { workIcon } from "./workIcons"
import { sidebarRef } from "./drawer"
import { Spinner, IconButton } from "./Common.mun"
import {
  runtimeState, workspaceChanges, activeAgents, connection, page, isWide, ease, connected, openPage, openSheet, newSession, openSession,
  toggleSidebar, age, sessionQuery, filteredSessions, manageSession, spansWorkspaces,
} from "./state"

struct NavItem: View {
  let id: String
  let title: String
  let icon: String
  let badge: String
  var body: some View {
    Button(action: { openPage(id) }, label: {
      HStack(spacing: 8) {
        Icon(workIcon(icon), { width: 16, height: 16, strokeWidth: 1.6 })
        Text(title).lineLimit(1).style({ minWidth: "0" })
        Spacer()
        if badge {
          Text(badge).withProps({ className: "nav-count" })
        }
      }
    })
    .withProps({ className: "nav-item", "aria-current": page.value === id ? "page" : undefined })
  }
}

/** An entry that opens a sheet rather than a page. */
struct NavSheet: View {
  let sheet: String
  let title: String
  let icon: String
  var body: some View {
    Button(action: { openSheet(sheet) }, label: {
      HStack(spacing: 8) {
        Icon(workIcon(icon), { width: 16, height: 16, strokeWidth: 1.6 })
        Text(title).lineLimit(1).style({ minWidth: "0" })
        Spacer()
      }
    })
    .withProps({ className: "nav-item", "aria-haspopup": "dialog" })
    .disabled(!connected())
  }
}

struct SessionRow: View {
  let session: Any
  let showWorkspace: Bool
  var body: some View {
    Button(action: { openSession(session.id, session.workspace_path) }, label: {
      HStack(spacing: 8) {
        if session.id === runtimeState.value.current_session_id && runtimeState.value.is_streaming {
          Spinner()
        }
        Text(session.title || "Untitled").lineLimit(1).style({ flex: "1", minWidth: "0" })
        // One list, not one list per workspace: label the row instead.
        if showWorkspace {
          Text(session.workspace_label).fontSize(11).foregroundStyle(color.faint).lineLimit(1)
            .withProps({ className: "session-workspace", title: session.workspace_path })
        }
        Text(age(session.updated_at)).fontSize(11).foregroundStyle(color.faint)
      }
    })
    .withProps({ className: "session-row", title: session.title || "Untitled", "aria-current": session.id === runtimeState.value.current_session_id ? "true" : undefined })
    .disabled(!connected())
  }
}

struct Header: View {
  var body: some View {
    HStack(spacing: 8) {
      Image("/yeet-mark.svg").style({ width: "20px", height: "20px" })
      Text("Yeet").fontSize(14).fontWeight("semibold")
      Text("Remote").withProps({ className: "brand-tag" })
      Spacer()
      IconButton(icon: "sidebar", label: "Hide sidebar", action: { toggleSidebar(false) })
    }
    .withProps({ className: "sidebar-header" })
  }
}

struct Navigation: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      NavItem(id: "chat", title: "Sessions", icon: "chat", badge: "")
      NavItem(id: "files", title: "Files", icon: "folder", badge: "")
      NavItem(id: "diff", title: "Diff", icon: "diff", badge: workspaceChanges.value?.files.length ? String(workspaceChanges.value.files.length) : "")
      NavItem(id: "agents", title: "Agents", icon: "agents", badge: activeAgents.value ? String(activeAgents.value) : "")
      NavItem(id: "tasks", title: "Scheduled tasks", icon: "calendar", badge: "")
      NavSheet(sheet: "capabilities", title: "Capabilities", icon: "extensions")
      NavItem(id: "debate", title: "Debate", icon: "debate", badge: "")
      if runtimeState.value.extension_commands?.length {
        NavItem(id: "extensions", title: "Extensions", icon: "extensions", badge: "")
      }
    }
    .withProps({ className: "sidebar-nav", role: "group", "aria-label": "Views" })
  }
}

struct Sessions: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      HStack(spacing: 8) {
        Icon(workIcon("search"), { width: 14, height: 14, strokeWidth: 1.6 })
          .foregroundStyle(color.faint)
        TextField(Binding(sessionQuery), "Search sessions")
          .accessibilityLabel("Search sessions")
          .withProps({ className: "session-search", type: "search" })
      }
      .withProps({ className: "search-field" })
      Text(sessionQuery.value ? "Search results" : "Recent sessions")
        .withProps({ className: "section-label sidebar-section" })
      ForEach(filteredSessions(), { id: session => session.id }) { session in
        HStack(spacing: 0) {
          SessionRow(session: session, showWorkspace: spansWorkspaces()).style({ flex: "1", minWidth: "0" })
          IconButton(icon: "more", label: "Manage " + (session.title || "Untitled"), action: { manageSession(session.id, session.title || "Untitled") })
            .withProps({ className: "icon-button session-menu" })
        }.withProps({ className: "session-item" })
      }
      if filteredSessions().length === 0 {
        Text(sessionQuery.value ? "No matching sessions" : "Your sessions will appear here")
          .foregroundStyle(color.muted)
          .withProps({ className: "sidebar-empty" })
      }
    }
  }
}

/** Sentence-case state, shown only while not connected. */
function connectionState(): string {
  const label = (connection.value || "offline").replace(/-/g, " ")
  return label.charAt(0).toUpperCase() + label.slice(1)
}

struct Footer: View {
  var body: some View {
    HStack(spacing: 8) {
      Button(action: { openSheet("settings") }, label: {
        HStack(spacing: 8) {
          Icon(workIcon("settings"), { width: 16, height: 16 })
          Text("Settings")
        }
      }).withProps({ className: "sidebar-settings" })
      Spacer()
      if !connected() {
        Text(connectionState()).fontSize(12).foregroundStyle(color.muted)
      }
    }
    .withProps({ className: "sidebar-footer" })
  }
}

export struct Sidebar: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      Header()
      Button(action: { newSession() }, label: {
        HStack(spacing: 8) {
          Icon(workIcon("plus"), { width: 16, height: 16, strokeWidth: 1.8 })
          Text("New session").fontWeight("medium")
          Spacer()
        }
      })
      .withProps({ className: "btn new-session" })
      .disabled(!connected())
      ScrollView() {
        VStack(alignment: .stretch, spacing: 0) {
          Navigation()
          Sessions()
        }
      }
      .withProps({ className: "sidebar-scroll", role: "region", "aria-label": "Sessions and navigation" })
      .style({ flex: "1 1 0", minHeight: "0" })
      Footer()
    }
    .withProps({ id: "sidebar", role: isWide.value ? "navigation" : "dialog", "aria-modal": isWide.value ? undefined : "true", "aria-label": "Workspace navigation", ref: sidebarRef })
    .style({ width: "264px", maxWidth: "calc(100vw - 40px)", height: "100%", flex: "none", position: isWide.value ? "relative" : "fixed", top: "0", left: "0", zIndex: "var(--z-pane)" })
  }
}

export struct Scrim: View {
  var body: some View {
    ZStack(alignment: .center) {
      DrawerBlur(edge: "leading")
      Button("") { toggleSidebar(false) }
        .accessibilityLabel("Close navigation")
        .withProps({ className: "drawer-scrim", tabindex: "-1" })
        .transition(Transition.opacity)
    }.withProps({ className: "drawer-scrim-layer" })
  }
}
