import { Transition, withAnimation } from "@mun/core"
import { color } from "./theme"
import { Spinner } from "./Common.mun"
import {
  remote, page, workspaceMenu, isWide, ease, connected, openPage, openSheet, newSession, openSession,
  chooseWorkspace, workspaces, toggleSidebar, age, sessionQuery, filteredSessions,
} from "./state"

/** Quiet navigation, distinct from the recent-session list. */
struct NavItem: View {
  let id: String
  let title: String
  let badge: String
  @State var hovering: Bool = false
  var body: some View {
    Button(action: { openPage(id) }, label: {
      HStack(spacing: 8) {
        Text(title).fontSize(15)
        Spacer()
        Text(badge).fontSize(12).foregroundStyle(color.faint)
      }
    })
    .foregroundStyle(color.text2)
    .padding({ top: 6, bottom: 6, leading: 14, trailing: 14 })
    .background(page.value === id ? color.navSelect : hovering.value ? color.navHover : "transparent")
    .style({ borderRadius: "8px" })
    .animation(ease, value: page.value === id || hovering.value)
    .onHover(inside => { hovering.value = inside })
  }
}

/** A compact session row with activity only while running. */
struct SessionRow: View {
  let session: Any
  @State var hovering: Bool = false
  var body: some View {
    Button(action: { openSession(session.id) }, label: {
      VStack(alignment: .stretch, spacing: 2) {
        HStack(spacing: 6) {
          if session.id === remote.value.state.current_session_id && remote.value.state.is_streaming {
            Spinner()
              .transition(Transition.opacity)
          }
          Text(session.title || "Untitled").fontSize(14).lineLimit(1)
          Spacer()
        }
        Text(age(session.updated_at)).fontSize(12).foregroundStyle(color.muted)
      }
    })
    .foregroundStyle(color.text2)
    .padding({ top: 7, bottom: 7, leading: 14, trailing: 14 })
    .background(session.id === remote.value.state.current_session_id ? color.sessionSelect : hovering.value ? color.hover : "transparent")
    .style({ borderRadius: "10px" })
    .animation(ease, value: hovering.value)
    .onHover(inside => { hovering.value = inside })
    .disabled(!connected())
  }
}

struct WorkspaceMenu: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 1) {
      ForEach(workspaces(), { id: item => item.id }) { item in
        Button(item.label) { chooseWorkspace(item.path, item.id) }
          .fontSize(13)
          .foregroundStyle(item.selected ? color.text : color.text2)
          .padding({ top: 5, bottom: 5, leading: 14, trailing: 14 })
          .background(item.selected ? color.sessionSelect : "transparent")
          .style({ borderRadius: "8px" })
      }
    }
    .padding({ bottom: 6 })
    .transition(Transition.opacity.combined(Transition.move("top", 6)))
  }
}

struct Header: View {
  var body: some View {
    HStack(spacing: 8) {
      Spacer()
      Button("New session") { newSession() }
        .fontSize(13)
        .foregroundStyle(color.muted)
        .disabled(!connected())
      Button("⟨") { toggleSidebar(false) }
        .accessibilityLabel("Hide sidebar")
        .fontSize(14)
        .foregroundStyle(color.muted)
        .padding({ leading: 6, trailing: 6 })
    }
    .style({ height: "30px", flex: "none" })
  }
}

struct Search: View {
  var body: some View {
    TextField(Binding(sessionQuery), "Search sessions")
      .accessibilityLabel("Search sessions")
      .fontSize(14)
      .padding({ top: 9, bottom: 9, leading: 14, trailing: 14 })
      .background(color.field)
      .style({ border: "0", outline: "none", borderRadius: "8px", width: "100%", color: "inherit" })
  }
}

struct Navigation: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 1) {
      NavItem(id: "chat", title: "Sessions", badge: "")
      NavItem(id: "files", title: "Files", badge: "")
      NavItem(id: "diff", title: "Diff", badge: remote.value.workspaceChanges?.files.length ? String(remote.value.workspaceChanges.files.length) : "")
      NavItem(id: "agents", title: "Agents", badge: remote.value.agents?.active_count ? String(remote.value.agents.active_count) : "")
    }
  }
}

struct WorkspaceSelection: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      Button(action: { withAnimation(ease) { workspaceMenu.value = !workspaceMenu.value } }, label: {
        HStack(spacing: 4) {
          Text(remote.value.currentWorkspace?.display_name || "Workspace").fontSize(14)
          Text("›").fontSize(14).rotationEffect(workspaceMenu.value ? 270 : 90).animation(ease, value: workspaceMenu.value)
          Spacer()
        }
      })
      .foregroundStyle(color.muted)
      .padding({ top: 4, bottom: 4, leading: 2 })
      .disabled(!connected())
      if workspaceMenu.value {
        WorkspaceMenu()
      }
    }
  }
}

struct Sessions: View {
  var body: some View {
    ScrollView() {
      VStack(alignment: .stretch, spacing: 2) {
        ForEach(filteredSessions(), { id: session => session.id }) { session in
          SessionRow(session: session)
        }
      }
    }
    .style({ flex: "1", minHeight: "0" })
  }
}

struct Footer: View {
  var body: some View {
    HStack(spacing: 8) {
      Text(connected() ? "" : remote.value.connection)
        .fontSize(12)
        .foregroundStyle(color.muted)
      Spacer()
      Button("Settings") { openSheet("settings") }
        .fontSize(13)
        .foregroundStyle(color.muted)
    }
    .padding({ top: 10, leading: 4, trailing: 4 })
  }
}

export struct Sidebar: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      Header()
      WorkspaceSelection().padding({ top: 12, bottom: 16 })
      Navigation().padding({ bottom: 20 })
      Search().padding({ bottom: 12 })
      Sessions()
      Footer()
    }
    .padding({ top: 14, bottom: 16, leading: 20, trailing: 20 })
    .withProps({ id: "sidebar", role: "navigation", "aria-label": "Workspace navigation" })
    .background(color.sidebar)
    .style({ width: "272px", maxWidth: "calc(100vw - 40px)", height: "100%", flex: "none", position: isWide.value ? "relative" : "fixed", top: "0", left: "0", zIndex: "10" })
  }
}

/** Dims the conversation behind the sidebar on narrow screens. */
export struct Scrim: View {
  var body: some View {
    Rectangle()
      .style({ position: "fixed", inset: "0", zIndex: "9", background: "var(--scrim)" })
      .onTapGesture(() => toggleSidebar(false))
      .transition(Transition.opacity)
  }
}
