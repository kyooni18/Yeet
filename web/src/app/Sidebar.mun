import { Icon, Transition, withAnimation } from "@mun/core"
import { color } from "./theme"
import { workIcon } from "./workIcons"
import { sidebarRef } from "./drawer"
import { Spinner, IconButton } from "./Common.mun"
import {
  remote, page, workspaceMenu, isWide, ease, connected, openPage, openSheet, newSession, openSession,
  chooseWorkspace, workspaces, toggleSidebar, age, sessionQuery, filteredSessions, manageSession,
} from "./state"

struct NavItem: View {
  let id: String
  let title: String
  let icon: String
  let badge: String
  var body: some View {
    Button(action: { openPage(id) }, label: {
      HStack(spacing: 10) {
        Icon(workIcon(icon), { width: 18, height: 18, strokeWidth: 1.6 })
        Text(title).fontSize(14)
        Spacer()
        if badge {
          Text(badge).withProps({ className: "nav-count" })
        }
      }
    })
    .withProps({ className: "nav-item", "aria-current": page.value === id ? "page" : undefined })
  }
}

struct SessionRow: View {
  let session: Any
  var body: some View {
    Button(action: { openSession(session.id) }, label: {
      HStack(spacing: 8) {
        if session.id === remote.value.state.current_session_id && remote.value.state.is_streaming {
          Spinner()
        }
        Text(session.title || "Untitled").lineLimit(1).style({ flex: "1", minWidth: "0" })
        Text(age(session.updated_at)).fontSize(11).foregroundStyle(color.faint)
      }
    })
    .withProps({ className: "session-row", title: session.title || "Untitled", "aria-current": session.id === remote.value.state.current_session_id ? "true" : undefined })
    .disabled(!connected())
  }
}

struct WorkspaceRow: View {
  let item: Any
  var body: some View {
    Button(action: { chooseWorkspace(item.path, item.id) }, label: {
      HStack(spacing: 8) {
        Icon(workIcon("folder"), { width: 15, height: 15, strokeWidth: 1.6 })
        Text(item.label).lineLimit(1).style({ flex: "1", minWidth: "0" })
        if item.selected {
          Icon(workIcon("check"), { width: 14, height: 14 })
        }
      }
    })
    .withProps({ className: "workspace-choice", title: item.path, "aria-current": item.selected ? "true" : undefined })
    .disabled(!connected())
  }
}

struct WorkspaceMenu: View {
  var body: some View {
    ScrollView() {
      VStack(alignment: .stretch, spacing: 2) {
        ForEach(workspaces(), { id: item => item.id }) { item in
          WorkspaceRow(item: item)
        }
      }
    }
    .withProps({ id: "workspace-list", role: "region", "aria-label": "Workspaces", tabindex: "0" })
    .style({ maxHeight: "min(240px, 32dvh)", flexShrink: "0", marginTop: "6px" })
    .transition(Transition.opacity.combined(Transition.move("top", 4)))
  }
}

struct Header: View {
  var body: some View {
    HStack(spacing: 8) {
      Image("/yeet-mark.svg").style({ width: "28px", height: "28px" })
      Text("Yeet").fontSize(20).fontWeight("semibold").style({ letterSpacing: "-0.6px" })
      Text("REMOTE").withProps({ className: "brand-tag" })
      Spacer()
      IconButton(icon: "sidebar", label: "Hide sidebar", action: { toggleSidebar(false) })
    }
    .withProps({ className: "sidebar-header" })
  }
}

struct Navigation: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      NavItem(id: "chat", title: "Sessions", icon: "chat", badge: "")
      NavItem(id: "files", title: "Files", icon: "folder", badge: "")
      NavItem(id: "diff", title: "Diff", icon: "diff", badge: remote.value.workspaceChanges?.files.length ? String(remote.value.workspaceChanges.files.length) : "")
      NavItem(id: "agents", title: "Agents", icon: "agents", badge: remote.value.agents?.active_count ? String(remote.value.agents.active_count) : "")
      NavItem(id: "tasks", title: "Scheduled tasks", icon: "calendar", badge: "")
      NavItem(id: "debate", title: "Debate", icon: "debate", badge: "")
      if remote.value.state.extension_commands?.length {
        NavItem(id: "extensions", title: "Extensions", icon: "extensions", badge: "")
      }
    }
    .padding({ top: 12, bottom: 16 })
  }
}

struct WorkspaceSelection: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      Text("Workspace").withProps({ className: "section-label" })
      Button(action: { withAnimation(ease) { workspaceMenu.value = !workspaceMenu.value } }, label: {
        HStack(spacing: 8) {
          Icon(workIcon("folder"), { width: 16, height: 16, strokeWidth: 1.6 })
          Text(remote.value.currentWorkspace?.display_name || "Workspace").lineLimit(1).style({ flex: "1", minWidth: "0" })
          Icon(workIcon("chevron"), { width: 14, height: 14 })
            .rotationEffect(workspaceMenu.value ? 270 : 90)
            .animation(ease, value: workspaceMenu.value)
        }
      })
      .withProps({ className: "workspace-toggle", "aria-label": "Switch workspace", "aria-expanded": workspaceMenu.value, "aria-controls": "workspace-list" })
      .disabled(!connected())
      if workspaceMenu.value {
        WorkspaceMenu()
        Button("Open another workspace…") { openSheet("workspace") }
          .withProps({ className: "workspace-choice" }).fontSize(13).disabled(!connected())
      }
    }
    .padding({ bottom: 18 })
  }
}

struct Sessions: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      HStack(spacing: 8) {
        Icon(workIcon("search"), { width: 15, height: 15, strokeWidth: 1.6 })
          .foregroundStyle(color.faint)
        TextField(Binding(sessionQuery), "Search sessions")
          .accessibilityLabel("Search sessions")
          .withProps({ className: "session-search", type: "search" })
      }
      .withProps({ className: "search-field" })
      Text(sessionQuery.value ? "Search results" : "Recent sessions")
        .withProps({ className: "section-label" })
        .padding({ top: 12, bottom: 4 })
      ForEach(filteredSessions(), { id: session => session.id }) { session in
        HStack(spacing: 0) {
          SessionRow(session: session).style({ flex: "1", minWidth: "0" })
          IconButton(icon: "more", label: "Manage " + (session.title || "Untitled"), action: { manageSession(session.id, session.title || "Untitled") })
            .withProps({ className: "icon-button session-menu" })
        }.withProps({ className: "session-item" })
      }
      if filteredSessions().length === 0 {
        Text(sessionQuery.value ? "No matching sessions" : "Your sessions will appear here")
          .fontSize(13).foregroundStyle(color.faint)
          .padding({ top: 8, bottom: 8, leading: 10, trailing: 10 })
      }
    }
  }
}

struct Footer: View {
  var body: some View {
    HStack(spacing: 8) {
      Button(action: { openSheet("settings") }, label: {
        HStack(spacing: 10) {
          Icon(workIcon("settings"), { width: 16, height: 16 })
          Text("Settings")
        }
      }).withProps({ className: "sidebar-settings" })
      Spacer()
      if !connected() {
        Text(remote.value.connection).fontSize(12).foregroundStyle(color.muted)
      }
    }
    .withProps({ className: "sidebar-footer" })
  }
}

export struct Sidebar: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      Header()
      Button(action: { newSession() }, label: {
        HStack(spacing: 9) {
          Icon(workIcon("plus"), { width: 17, height: 17, strokeWidth: 1.8 })
          Text("New session").fontSize(14).fontWeight("medium")
          Spacer()
        }
      })
      .withProps({ className: "new-session" })
      .disabled(!connected())
      ScrollView() {
        VStack(alignment: .stretch, spacing: 0) {
          Navigation()
          WorkspaceSelection()
          Sessions()
        }
      }
      .withProps({ className: "sidebar-scroll", role: "region", "aria-label": "Workspaces and sessions" })
      .style({ flex: "1 1 0", minHeight: "0" })
      Footer()
    }
    .withProps({ id: "sidebar", role: isWide.value ? "navigation" : "dialog", "aria-modal": isWide.value ? undefined : "true", "aria-label": "Workspace navigation", ref: sidebarRef })
    .style({ width: "264px", maxWidth: "calc(100vw - 40px)", height: "100%", flex: "none", position: isWide.value ? "relative" : "fixed", top: "0", left: "0", zIndex: "12" })
  }
}

export struct Scrim: View {
  var body: some View {
    Button("") { toggleSidebar(false) }
      .accessibilityLabel("Close navigation")
      .withProps({ className: "drawer-scrim", tabindex: "-1" })
      .transition(Transition.opacity)
  }
}
