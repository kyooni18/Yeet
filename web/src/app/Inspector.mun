import { Icon, Transition } from "@mun/core"
import { remoteStore } from "@/store/remoteStore"
import { workIcon } from "./workIcons"
import { color } from "./theme"
import { inspectorRef } from "./drawer"
import { IconButton } from "./Common.mun"
import { Patch } from "./Pages.mun"
import { tokenCount, activeProvider, subscription, resetLabel } from "./status"
import {
  statusSnapshot as remote, workspaceFiles, workspaceChanges, connected, isDesktop, inspectorTab, toggleInspector, selectInspectorTab,
  refreshInspector, displayPath, openPage, openSheet, contextLabel, shortModel,
} from "./state"

function changeSummary(): string {
  const files = workspaceChanges.value?.files
  if (!files) return connected() ? "Loading changes…" : "Unavailable offline"
  if (!files.length) return workspaceChanges.value?.message ? "Changes unavailable" : "No changed files"
  const added = files.reduce((sum, file) => sum + (file.added ?? 0), 0)
  const removed = files.reduce((sum, file) => sum + (file.removed ?? 0), 0)
  return files.length + (files.length === 1 ? " changed file" : " changed files") + " · +" + added + " −" + removed
}

struct PanelRow: View {
  let title: String
  let detail: String
  let icon: String
  let selected: Bool
  let action: () => void
  var body: some View {
    Button(action: action, label: {
      HStack(spacing: 8) {
        Icon(workIcon(icon), { width: 16, height: 16, strokeWidth: 1.6 })
          .foregroundStyle(color.faint)
        Text(title).lineLimit(1).style({ minWidth: "0", flex: "1" })
        Text(detail).fontSize(11).foregroundStyle(color.muted).style({ whiteSpace: "nowrap" })
      }
    })
    .withProps({ className: "panel-row", title, "aria-pressed": selected })
    .disabled(!connected())
  }
}

struct PanelEmpty: View {
  let icon: String
  let title: String
  let detail: String
  var body: some View {
    VStack(alignment: .center, spacing: 8) {
      Icon(workIcon(icon), { width: 28, height: 28, strokeWidth: 1.3 }).foregroundStyle(color.faint)
      Text(title).fontSize(14).fontWeight("medium")
      Text(detail).fontSize(12).foregroundStyle(color.muted).style({ textAlign: "center", maxWidth: "240px" })
    }
    .withProps({ className: "panel-empty" })
  }
}

struct Changes: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      HStack(spacing: 8) {
        Text("WORKING CHANGES").withProps({ className: "section-label" })
        Spacer()
        IconButton(icon: "expand", label: "Open full diff", action: { openPage("diff") })
      }
      if workspaceChanges.value === null {
        PanelEmpty(icon: "diff", title: connected() ? "Loading changes…" : "Not connected", detail: "Workspace changes will appear here.")
      } else if workspaceChanges.value.files.length === 0 {
        PanelEmpty(icon: workspaceChanges.value.message ? "info" : "check", title: workspaceChanges.value.message ? "Changes unavailable" : "All caught up", detail: workspaceChanges.value.message || "No uncommitted changes in this workspace.")
      } else {
        ForEach(workspaceChanges.value.files, { id: file => file.path }) { file in
          PanelRow(
            title: file.path,
            detail: file.added === null ? file.status.trim() : "+" + file.added + " −" + (file.removed ?? 0),
            icon: "file", selected: file.path === workspaceChanges.value.selected,
            action: { remoteStore.requestChanges(file.path, false) }
          )
        }
        if workspaceChanges.value.patch.length {
          VStack(alignment: .stretch, spacing: 0) {
            Text("DIFF PREVIEW").withProps({ className: "section-label" }).padding({ top: 14, bottom: 10 })
            Patch().withProps({ className: "inspector-patch", tabindex: "0", "aria-label": "Diff preview" })
          }
          .style({ height: "280px", minHeight: "0" })
        }
      }
    }.style({ width: "100%", minWidth: "0" })
  }
}

struct Files: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      HStack(spacing: 6) {
        Text(workspaceFiles.value?.path || "WORKSPACE FILES")
          .withProps({ className: "section-label" }).lineLimit(1).style({ minWidth: "0" })
        Spacer()
        if workspaceFiles.value?.parent !== null && workspaceFiles.value?.parent !== undefined {
          IconButton(icon: "arrow", label: "Parent folder", action: { remoteStore.requestFiles(workspaceFiles.value.parent) })
            .disabled(!connected())
        }
        IconButton(icon: "expand", label: "Open file browser", action: { openPage("files") })
      }
      if workspaceFiles.value === null {
        PanelEmpty(icon: "folder", title: connected() ? "Loading files…" : "Not connected", detail: "Browse files without leaving the conversation.")
      } else if workspaceFiles.value.entries.length === 0 {
        PanelEmpty(icon: "folder", title: "Empty folder", detail: "There are no files in this directory.")
      } else {
        ForEach(workspaceFiles.value.entries, { id: entry => entry.path }) { entry in
          PanelRow(
            title: entry.name, detail: entry.directory ? "›" : entry.status ? "Modified" : "",
            icon: entry.directory ? "folder" : "file", selected: entry.path === workspaceFiles.value.selected,
            action: { entry.directory ? remoteStore.requestFiles(entry.path) : remoteStore.requestFiles(workspaceFiles.value.path, entry.path) }
          )
        }
      }
      if workspaceFiles.value?.info {
        VStack(alignment: .stretch, spacing: 6) {
          Text("FILE DETAILS").withProps({ className: "section-label" })
          Text(workspaceFiles.value.info.name).fontSize(14).fontWeight("medium")
          Text([Math.ceil(workspaceFiles.value.info.size / 1024) + " KB", workspaceFiles.value.info.lines ? workspaceFiles.value.info.lines + " lines" : ""].filter(Boolean).join(" · "))
            .fontSize(12).foregroundStyle(color.muted)
          if workspaceFiles.value.info.status {
            Button("Review changes →") {
              remoteStore.requestChanges(workspaceFiles.value.info.path, false)
              selectInspectorTab("changes")
            }
            .withProps({ className: "panel-link" }).disabled(!connected())
          }
        }
        .withProps({ className: "file-details" })
      }
    }.style({ width: "100%", minWidth: "0" })
  }
}

struct StatusRow: View {
  let label: String
  let value: String
  var body: some View {
    HStack(alignment: .top, spacing: 12) {
      Text(label).foregroundStyle(color.muted)
      Spacer()
      Text(value).style({ textAlign: "right", overflowWrap: "anywhere", minWidth: "0" })
    }.withProps({ className: "status-row" })
  }
}

struct SessionStatus: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 12) {
      Text("SESSION").withProps({ className: "section-label" })
      StatusRow(label: "State", value: remote.value.state.is_streaming ? "Working" : connected() ? "Ready" : remote.value.connection)
      Button(action: { openSheet("model") }, label: {
        StatusRow(label: "Model", value: shortModel(remote.value.state.active_model) || "Choose a model")
      }).withProps({ className: "panel-model", title: remote.value.state.active_model }).disabled(!connected())
      StatusRow(label: "Reasoning", value: remote.value.state.active_reasoning_level || "Default")
      StatusRow(label: "Agents", value: String(remote.value.agents?.active_count ?? 0))
      Text("CONTEXT").withProps({ className: "section-label status-section" })
      StatusRow(label: "Window used", value: contextLabel() || "Not reported")
      if remote.value.contextPercent !== null {
        Element("meter", { min: 0, max: 100, value: remote.value.contextPercent, "aria-label": "Context usage" }).style({ width: "100%" })
      }
      Text(tokenCount(remote.value.state.current_context_tokens) + " / " + tokenCount(remote.value.state.active_model_context_length) + " tokens").withProps({ className: "status-caption" })
      Text("SESSION USAGE").withProps({ className: "section-label status-section" })
      StatusRow(label: "Input tokens", value: tokenCount(remote.value.state.token_usage.input_tokens))
      StatusRow(label: "Output tokens", value: tokenCount(remote.value.state.token_usage.output_tokens))
      StatusRow(label: "Reasoning tokens", value: tokenCount(remote.value.state.token_usage.reasoning_tokens))
      StatusRow(label: "Cached input", value: tokenCount(remote.value.state.token_usage.cached_input_tokens))
      StatusRow(label: "Cache writes", value: tokenCount(remote.value.state.token_usage.cache_creation_input_tokens))
      StatusRow(label: "Model calls", value: tokenCount(remote.value.state.token_usage.model_calls))
      if !subscription(remote.value.state) {
        StatusRow(label: "Cost", value: "Not reported by server")
      }
      Text("PROVIDER LIMITS").withProps({ className: "section-label status-section" })
      if activeProvider(remote.value.state) {
        StatusRow(label: "Provider", value: activeProvider(remote.value.state).provider)
        if activeProvider(remote.value.state).usage?.plan {
          StatusRow(label: "Plan", value: activeProvider(remote.value.state).usage.plan)
        }
        ForEach(activeProvider(remote.value.state).usage?.windows ?? [], { id: window => window.id }) { window in
          VStack(alignment: .stretch, spacing: 6) {
            StatusRow(label: window.label, value: Math.round(window.remainingPercent) + "% remaining")
            Element("meter", { min: 0, max: 100, value: window.usedPercent, "aria-label": window.label + " usage" }).style({ width: "100%" })
            Text(resetLabel(window.resetsAt)).withProps({ className: "status-caption" })
          }
        }
        if !activeProvider(remote.value.state).usage?.windows.length {
          Text(activeProvider(remote.value.state).usage?.message || "Usage limits not reported").withProps({ className: "status-caption" })
        }
        if activeProvider(remote.value.state).usage?.fetchedAt {
          Text("Updated " + new Date(activeProvider(remote.value.state).usage.fetchedAt).toLocaleTimeString()).withProps({ className: "status-caption" })
        }
      } else {
        Text("Provider usage not reported for this model").withProps({ className: "status-caption" })
      }
      Button("Manage providers & authentication") { openSheet("auth") }.withProps({ className: "panel-link" })
    }.withProps({ className: "session-status" }).style({ width: "100%", minWidth: "0" })
  }
}

export struct WorkspacePanel: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      HStack(spacing: 8) {
        Text("Session status").fontSize(14).fontWeight("semibold")
        Spacer()
        IconButton(icon: "refresh", label: "Refresh workspace", action: { refreshInspector() }).disabled(!connected())
        IconButton(icon: "inspector", label: "Hide workspace panel", action: { toggleInspector(false) })
      }.withProps({ className: "panel-header" }).style({ width: "100%" })
      ScrollView() {
        VStack(alignment: .stretch, spacing: 0) {
          VStack(alignment: .stretch, spacing: 6) {
            Text(remote.value.currentWorkspace?.display_name || "Workspace").fontSize(16).fontWeight("medium").lineLimit(1)
            Text(displayPath(remote.value.state.workspace_root)).fontSize(12).foregroundStyle(color.muted).lineLimit(1)
              .withProps({ title: remote.value.state.workspace_root })
            if workspaceChanges.value?.branch || workspaceFiles.value?.branch {
              HStack(spacing: 5) {
                Icon(workIcon("branch"), { width: 13, height: 13, strokeWidth: 1.6 })
                Text(workspaceChanges.value?.branch || workspaceFiles.value?.branch).fontSize(12).lineLimit(1)
              }.foregroundStyle(color.muted).style({ width: "100%", minWidth: "0" })
            }
            Text(changeSummary()).fontSize(12).foregroundStyle(color.muted).withProps({ className: "panel-summary" })
          }.withProps({ className: "panel-context" }).style({ width: "100%", minWidth: "0" })
          HStack(spacing: 4) {
            Button("Status") { selectInspectorTab("status") }
              .withProps({ className: "panel-tab", "aria-pressed": inspectorTab.value === "status" })
            Button("Changes" + (workspaceChanges.value?.files.length ? " · " + workspaceChanges.value.files.length : "")) { selectInspectorTab("changes") }
              .withProps({ className: "panel-tab", "aria-pressed": inspectorTab.value === "changes" })
            Button("Files") { selectInspectorTab("files") }
              .withProps({ className: "panel-tab", "aria-pressed": inspectorTab.value === "files" })
          }.withProps({ className: "panel-tabs", role: "group", "aria-label": "Workspace view" })
          VStack(alignment: .stretch, spacing: 0) {
            if inspectorTab.value === "status" { SessionStatus() } else if inspectorTab.value === "changes" { Changes() } else { Files() }
          }.withProps({ className: "panel-content" }).style({ width: "100%", minWidth: "0" })
        }.style({ width: "100%", minWidth: "0" })
      }.withProps({ className: "panel-scroll", role: "region", "aria-label": "Workspace details", tabindex: "0" })
        .style({ flex: "1 1 0", minHeight: "0", width: "100%" })
    }
    .withProps({ id: "workspace-panel", role: isDesktop.value ? "complementary" : "dialog", "aria-modal": isDesktop.value ? undefined : "true", "aria-label": "Workspace panel", ref: inspectorRef })
    .style({ width: "320px", maxWidth: "calc(100vw - 24px)", height: "100%", flex: "none", position: isDesktop.value ? "relative" : "fixed", top: "0", right: "0", zIndex: "12" })
  }
}

export struct InspectorScrim: View {
  var body: some View {
    Button("") { toggleInspector(false) }
      .accessibilityLabel("Close workspace panel")
      .withProps({ className: "drawer-scrim", tabindex: "-1" })
      .transition(Transition.opacity)
  }
}
