import { Icon } from "@mun/core"
import { workIcon } from "./workIcons"
import { color, mono } from "./theme"
import { spring, quick, isRoomy } from "./state"
import { GlassIf } from "./Blur.mun"

/** A small, neutral activity ring; never attached to provider narration.
 * Rotation is a compositor-only CSS animation, so it costs no view updates. */
export struct Spinner: View {
  var body: some View {
    Element("span")
      .style({ width: "12px", height: "12px", boxSizing: "border-box", background: "transparent", border: "1.5px solid var(--line)", borderTopColor: "var(--muted)", borderRadius: "50%", flex: "none" })
      .withProps({ className: "activity-spinner" })
      .accessibilityLabel("Working")
  }
}

/** Heading for content inside a pane. The page's own name lives in the title bar. */
export struct SectionHeading: View {
  let title: String
  let subtitle: String = ""
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      Text(title).lineLimit(1).withProps({ className: "section-heading", role: "heading", "aria-level": "2" })
      if subtitle {
        Text(subtitle).fontSize(12).foregroundStyle(color.muted).lineLimit(1)
      }
    }
  }
}

/** A label that belongs to the field right below it: close to that field, and further from
 * the previous group, so the grouping reads without rules. */
export struct FieldLabel: View {
  let text: String
  var body: some View {
    Text(text)
      .fontSize(12)
      .foregroundStyle(color.muted)
      .style({ marginBottom: "-6px" })
  }
}

/** One key of a segmented control. The selected key takes the raised button material. */
struct SegmentKey: View {
  let label: String
  let selected: Bool
  let enabled: Bool
  let action: () => void
  @State var hovering: Bool = false
  var body: some View {
    Button(label, action)
      .disabled(!enabled)
      .withProps({ "aria-pressed": selected })
      .fontSize(12)
      .foregroundStyle(selected ? color.text : hovering.value ? color.text : color.muted)
      .style({ fontWeight: selected ? "var(--w-emphasis)" : "var(--w-base)", whiteSpace: "nowrap", flex: "1 1 auto" })
      .padding({ top: isRoomy() ? 12 : 4, bottom: isRoomy() ? 12 : 4, leading: 10, trailing: 10 })
      .background(LinearGradient(colors: [Color(selected ? color.btnTop : "transparent"), Color(selected ? color.btnBottom : "transparent")], startPoint: .top, endPoint: .bottom))
      .cornerRadius(6)
      .shadow(selected ? color.btnDrop : "transparent", 4, 0, 1)
      .opacity(enabled ? 1 : 0.45)
      .animation(quick, value: selected)
      .onHover(inside => { hovering.value = inside })
  }
}

/** One choice among a few peers; selection is a raised key plus weight, never colour alone. */
export struct Segmented: View {
  let label: String
  let options: Any
  let value: String
  let onChange: (value: string) => void
  let enabled: Bool = true
  let fill: Bool = false
  var body: some View {
    HStack(spacing: 2) {
      ForEach(options, { id: option => option.value }) { option in
        SegmentKey(label: option.label, selected: option.value === value, enabled: enabled, action: () => { onChange(option.value) })
      }
    }
    .style({ width: fill ? "100%" : "fit-content", flex: "none", flexWrap: "wrap" })
    .padding(2)
    .background(color.field)
    .cornerRadius(8)
    .withProps({ role: "group", "aria-label": label })
  }
}

/** Vertical padding that makes the button itself 28/32px (44px on touch and narrow
 * layouts), so the click target is exactly the visible control. */
function verticalPadding(small: boolean): number {
  return isRoomy() ? 14 : small ? 5 : 7
}

function textColor(kind: string, hovering: boolean): string {
  return kind === "disabled" ? color.muted : kind === "primary" ? color.accentInk : kind === "danger" ? color.del : kind === "quiet" ? (hovering ? color.text : color.muted) : color.text
}

/** A primary button that cannot act becomes a neutral key, like the disabled send button. */
function lookOf(kind: string, enabled: boolean): string {
  return kind === "primary" && !enabled ? "disabled" : kind
}

function sheenTop(kind: string): string {
  return kind === "disabled" ? color.field : kind === "primary" ? color.accentTop : kind === "quiet" ? "transparent" : color.btnTop
}

function edgeColor(kind: string): string {
  return kind === "disabled" ? "transparent" : kind === "primary" ? color.accentEdge : kind === "quiet" ? "transparent" : color.btnEdge
}

function dropColor(kind: string, pressed: boolean): string {
  return pressed || kind === "quiet" || kind === "disabled" ? "transparent" : kind === "primary" ? color.accentGlow : color.btnDrop
}

function sheenBottom(kind: string): string {
  return kind === "disabled" ? color.field : kind === "primary" ? color.accentBottom : kind === "quiet" ? "transparent" : color.btnBottom
}

/** The button material, written entirely in modifiers: a two-colour sheen, a hairline
 * edge, a cast shadow, and hover and pressed overlays. `kind` is primary, secondary or quiet. */
export struct ActionButton: View {
  let title: String
  let kind: String
  let small: Bool
  let enabled: Bool
  let action: () => void
  let icon: String = ""
  let block: Bool = false
  let pill: Bool = false
  let aria: String = ""
  let role: String = ""
  let checked: Bool = false
  @State var hovering: Bool = false
  @State var pressed: Bool = false
  var body: some View {
    Button(action: action, label: {
      HStack(spacing: 6) {
        GlassIf(on: kind === "glass", radius: pill ? 999 : 8, tint: color.glass)
        if icon {
          Icon(workIcon(icon), { width: small ? 12 : 14, height: small ? 12 : 14 })
        }
        Text(title).style({ whiteSpace: block ? "normal" : "nowrap", textAlign: block ? "left" : "center" })
      }
    })
      // Semantics first: modifiers after the first wrapper-making one would land on the wrapper.
      .disabled(!enabled)
      .accessibilityLabel(aria || title)
      .withProps({ role: role || undefined, "aria-checked": role === "switch" ? checked : undefined })
      .fontSize(small ? 12 : 13)
      .foregroundStyle(textColor(lookOf(kind, enabled), hovering.value))
      .padding({ top: verticalPadding(small), bottom: verticalPadding(small), leading: small ? 10 : 14, trailing: small ? 10 : 14 })
      .style({ flex: "none", justifyContent: block ? "flex-start" : "center", alignItems: "center", display: "inline-flex", width: block ? "100%" : "auto", isolation: "isolate", position: "relative" })
      .background(LinearGradient(colors: [Color(sheenTop(lookOf(kind, enabled))), Color(sheenBottom(lookOf(kind, enabled)))], startPoint: .top, endPoint: .bottom))
      .border(edgeColor(lookOf(kind, enabled)), 1)
      .cornerRadius(pill ? 999 : 8)
      .shadow(dropColor(lookOf(kind, enabled), pressed.value), 8, 0, pressed.value ? 0 : 3)
      .overlay(RoundedRectangle(pill ? 999 : 8).fill(pressed.value ? color.pressed : hovering.value ? color.hover : "transparent").allowsHitTesting(false))
      .offset(0, pressed.value ? 0.5 : 0)
      .opacity(enabled || kind === "primary" ? 1 : 0.45)
      .animation(quick, value: hovering.value)
      .animation(quick, value: pressed.value)
      .onHover(inside => { hovering.value = inside })
      .withProps({ onPointerDown: () => { pressed.value = true }, onPointerUp: () => { pressed.value = false }, onPointerLeave: () => { pressed.value = false }, onPointerCancel: () => { pressed.value = false } })
  }
}

/** The primary action of a view. */
export struct PrimaryButton: View {
  let title: String
  let enabled: Bool
  let action: () => void
  var body: some View {
    ActionButton(title: title, kind: "primary", small: false, enabled: enabled, action: action)
  }
}

/** Quiet text button used for toolbars and message actions. Deliberately light: every
 * message in a transcript carries several, so it keeps to one hover state and a
 * background, with none of the raised material's layers. */
export struct Chip: View {
  let title: String
  let action: () => void
  let aria: String = ""
  let enabled: Bool = true
  @State var hovering: Bool = false
  var body: some View {
    Button(title, action)
      .disabled(!enabled)
      .accessibilityLabel(aria || title)
      .fontSize(12)
      .foregroundStyle(hovering.value ? color.text : color.muted)
      .padding({ top: verticalPadding(true), bottom: verticalPadding(true), leading: 10, trailing: 10 })
      .background(hovering.value ? color.hover : "transparent")
      .cornerRadius(8)
      .opacity(enabled ? 1 : 0.45)
      .style({ flex: "none", whiteSpace: "nowrap" })
      .animation(quick, value: hovering.value)
      .onHover(inside => { hovering.value = inside })
  }
}

/** The composer's primary control: send, or stop while a run is streaming.
 * One flat key; colour, hover and press come from CSS so the shape stays concentric
 * with the composer surface (16px surface, 8px inset, 8px key). */
export struct SendButton: View {
  let streaming: Bool
  let enabled: Bool
  let label: String
  let action: () => void
  var body: some View {
    Button(action: action, label: {
      if streaming {
        RoundedRectangle(2).fill("currentColor").frame(width: 10, height: 10)
      } else {
        Icon(workIcon("arrow"), { width: 17, height: 17, strokeWidth: 2 })
      }
    })
      .disabled(!enabled)
      .accessibilityLabel(label)
      .withProps({ title: streaming ? "Stop generating" : "Send message", className: "send-button", "data-mode": streaming ? "stop" : "send" })
  }
}

/** Discrete choice as a slider: filled track, a dot per stop, the chosen label beside the name.
 * The value always round-trips through `onChange`; this view holds no state of its own. */
export struct StopSlider: View {
  let label: String
  let options: Any
  let value: String
  let onChange: (value: string) => void
  let enabled: Bool = true
  var body: some View {
    VStack(alignment: .stretch, spacing: 6) {
      HStack(spacing: 8) {
        Text(label).fontSize(13).foregroundStyle(color.muted)
        Spacer()
        Text(stopLabel(options, value)).fontSize(13).style({ fontWeight: "var(--w-emphasis)" }).withProps({ "aria-hidden": "true" })
      }
      ZStack(alignment: .center) {
        Element("span").withProps({ className: "stop-slider__track", "aria-hidden": "true" })
        Element("span").withProps({ className: "stop-slider__fill", "aria-hidden": "true" }).style({ width: stopPosition(options, value) })
        ForEach(stopIndices(options), { id: index => index }) { index in
          Element("span").withProps({ className: "stop-slider__stop", "aria-hidden": "true", "data-passed": index <= stopIndex(options, value) }).style({ left: stopAt(options, index) })
        }
        Slider(Binding(() => stopIndex(options, value), index => { onChange(options[Math.round(index)].value) }), { min: 0, max: options.length - 1, step: 1 })
          .accessibilityLabel(label)
          .disabled(!enabled)
          .withProps({ className: "stop-slider__input", "aria-valuetext": stopLabel(options, value) })
      }.withProps({ className: "stop-slider" })
      HStack(spacing: 8) {
        Text(options[0].label).fontSize(12).foregroundStyle(color.faint)
        Spacer()
        Text(options[options.length - 1].label).fontSize(12).foregroundStyle(color.faint)
      }
    }
    .style({ width: "100%", minWidth: "0" })
  }
}

function stopIndex(options: Any, value: string): number {
  return Math.max(0, options.findIndex(option => option.value === value))
}

function stopIndices(options: Any): Any {
  return options.map((option, index) => index)
}

function stopLabel(options: Any, value: string): string {
  return options[stopIndex(options, value)]?.label ?? ""
}

/** Thumb centres travel the track minus one thumb width (var(--thumb)). */
function stopAt(options: Any, index: number): string {
  return "calc(var(--thumb) / 2 + (100% - var(--thumb)) * " + (options.length > 1 ? index / (options.length - 1) : 0) + ")"
}

function stopPosition(options: Any, value: string): string {
  return stopAt(options, stopIndex(options, value))
}

/** Consistent hit area and native tooltip for shell actions. */
export struct IconButton: View {
  let icon: String
  let label: String
  let action: () => void
  var body: some View {
    Button(action: action, label: {
      Icon(workIcon(icon), { width: 18, height: 18, strokeWidth: 1.6 })
    })
    .accessibilityLabel(label)
    .withProps({ className: "icon-button", title: label })
  }
}
