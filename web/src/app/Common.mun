import { Icon } from "@mun/core"
import { workIcon } from "./workIcons"
import { color, mono } from "./theme"
import { spring, quick, isTouch } from "./state"

/** A small, neutral activity ring; never attached to provider narration.
 * Rotation is a compositor-only CSS animation, so it costs no view updates. */
export struct Spinner: View {
  var body: some View {
    Element("span")
      .style({ width: "12px", height: "12px", boxSizing: "border-box", background: "transparent", border: "1.5px solid var(--line)", borderTopColor: "var(--muted)", borderRadius: "50%", flex: "none" })
      .withProps({ className: "activity-spinner" })
      .accessibilityLabel("Working")
  }
}

/** Heading for content inside a pane. The page's own name lives in the title bar. */
export struct SectionHeading: View {
  let title: String
  let subtitle: String = ""
  var body: some View {
    VStack(alignment: .stretch, spacing: 2) {
      Text(title).lineLimit(1).withProps({ className: "section-heading", role: "heading", "aria-level": "2" })
      if subtitle {
        Text(subtitle).fontSize(12).foregroundStyle(color.muted).lineLimit(1)
      }
    }
  }
}

/** One choice among a few peers. The selected segment is raised and heavier,
 * and exposes its state as a pressed button. */
export struct Segmented: View {
  let label: String
  let options: Any
  let value: String
  let onChange: (value: string) => void
  var body: some View {
    HStack(spacing: 2) {
      ForEach(options, { id: option => option.value }) { option in
        Button(option.label) { onChange(option.value) }
          .withProps({ className: "segment", "aria-pressed": option.value === value })
      }
    }
    .withProps({ className: "segmented", role: "group", "aria-label": label })
  }
}

function textColor(kind: string, hovering: boolean): string {
  return kind === "primary" ? color.accentInk : kind === "danger" ? color.del : kind === "quiet" ? (hovering ? color.text : color.muted) : color.text
}

function sheenTop(kind: string): string {
  return kind === "primary" ? color.accentTop : kind === "quiet" ? "transparent" : color.btnTop
}

function edgeColor(kind: string): string {
  return kind === "primary" ? color.accentEdge : kind === "quiet" ? "transparent" : color.btnEdge
}

function dropColor(kind: string, pressed: boolean): string {
  return pressed || kind === "quiet" ? "transparent" : kind === "primary" ? color.accentGlow : color.btnDrop
}

function sheenBottom(kind: string): string {
  return kind === "primary" ? color.accentBottom : kind === "quiet" ? "transparent" : color.btnBottom
}

/** The button material, written entirely in modifiers: a two-colour sheen, a hairline
 * edge, a cast shadow, and hover and pressed overlays. `kind` is primary, secondary or quiet. */
export struct ActionButton: View {
  let title: String
  let kind: String
  let small: Bool
  let enabled: Bool
  let action: () => void
  let icon: String = ""
  let block: Bool = false
  let pill: Bool = false
  let aria: String = ""
  let role: String = ""
  let checked: Bool = false
  @State var hovering: Bool = false
  @State var pressed: Bool = false
  var body: some View {
    Button(action: action, label: {
      HStack(spacing: 6) {
        if icon {
          Icon(workIcon(icon), { width: small ? 12 : 14, height: small ? 12 : 14 })
        }
        Text(title).style({ whiteSpace: block ? "normal" : "nowrap", textAlign: block ? "left" : "center" })
      }
    })
      .fontSize(small ? 12 : 13)
      .foregroundStyle(textColor(kind, hovering.value))
      .padding({ top: 0, bottom: 0, leading: small ? 10 : 14, trailing: small ? 10 : 14 })
      .frame(minHeight: isTouch.value ? 44 : small ? 28 : 32)
      .background(LinearGradient(colors: [Color(sheenTop(kind)), Color(sheenBottom(kind))], startPoint: .top, endPoint: .bottom))
      .border(edgeColor(kind), 1)
      .cornerRadius(pill ? 999 : 8)
      .shadow(dropColor(kind, pressed.value), 8, 0, pressed.value ? 0 : 3)
      .overlay(RoundedRectangle(pill ? 999 : 8).fill(pressed.value ? color.pressed : hovering.value ? color.hover : "transparent").allowsHitTesting(false))
      .offset(0, pressed.value ? 0.5 : 0)
      .opacity(enabled ? 1 : 0.45)
      .style({ flex: "none", justifyContent: block ? "flex-start" : "center", alignItems: "center", display: "inline-flex", width: block ? "100%" : "auto" })
      .animation(quick, value: hovering.value)
      .animation(quick, value: pressed.value)
      .onHover(inside => { hovering.value = inside })
      .accessibilityLabel(aria || title)
      .withProps({ role: role || undefined, "aria-checked": role === "switch" ? checked : undefined, onPointerDown: () => { pressed.value = true }, onPointerUp: () => { pressed.value = false }, onPointerLeave: () => { pressed.value = false }, onPointerCancel: () => { pressed.value = false } })
      .disabled(!enabled)
  }
}

/** The primary action of a view. */
export struct PrimaryButton: View {
  let title: String
  let enabled: Bool
  let action: () => void
  var body: some View {
    ActionButton(title: title, kind: "primary", small: false, enabled: enabled, action: action)
  }
}

/** Quiet text button used for toolbars and message actions. */
export struct Chip: View {
  let title: String
  let action: () => void
  var body: some View {
    ActionButton(title: title, kind: "quiet", small: true, enabled: true, action: action)
  }
}

/** Consistent hit area and native tooltip for shell actions. */
export struct IconButton: View {
  let icon: String
  let label: String
  let action: () => void
  var body: some View {
    Button(action: action, label: {
      Icon(workIcon(icon), { width: 18, height: 18, strokeWidth: 1.6 })
    })
    .accessibilityLabel(label)
    .withProps({ className: "icon-button", title: label })
  }
}
