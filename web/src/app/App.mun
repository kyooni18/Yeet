import { Transition } from "@mun/core"
import { color } from "./theme"
import { connection, page, sheet, sidebarOpen, inspectorOpen, isWide, isDesktop, toast } from "./state"
import { AuthView } from "./Auth.mun"
import { Sidebar, Scrim } from "./Sidebar.mun"
import { WorkspacePanel, InspectorScrim } from "./Inspector.mun"
import { Chat } from "./Chat.mun"
import { TitleBar, StatusBar } from "./Frame.mun"
import { FilesPage, DiffPage } from "./Pages.mun"
import { AgentsPage } from "./Agents.mun"
import { TasksPage } from "./Tasks.mun"
import { DebatePage, ExtensionsPage } from "./Debate.mun"
import { SheetLayer } from "./Sheets.mun"

struct Content: View {
  var body: some View {
    Group() {
      if page.value === "files" {
        FilesPage()
      } else if page.value === "diff" {
        DiffPage()
      } else if page.value === "agents" {
        AgentsPage()
      } else if page.value === "tasks" {
        TasksPage()
      } else if page.value === "debate" {
        DebatePage()
      } else if page.value === "extensions" {
        ExtensionsPage()
      } else {
        Chat()
      }
    }
  }
}

struct Toast: View {
  var body: some View {
    Text(toast.value)
      .withProps({ role: "status" })
      .fontSize(13)
      .padding({ top: 8, bottom: 8, leading: 14, trailing: 14 })
      .background(color.accent)
      .foregroundStyle(color.accentInk)
      .style({ position: "fixed", bottom: "96px", left: "50%", translate: "-50% 0", borderRadius: "var(--r-control)", boxShadow: "var(--shadow-float)", zIndex: "var(--z-toast)" })
      .transition(Transition.opacity.combined(Transition.move("bottom", 6)))
  }
}

struct Shell: View {
  var body: some View {
    HStack(alignment: .stretch, spacing: 0) {
      Element("div", {}) {
        if sidebarOpen.value {
          Sidebar()
            .id("sidebar")
            .transition(Transition.move("leading", 280))
        }
      }.withProps({ className: "pane-slot pane-slot--leading", "data-open": sidebarOpen.value && isWide.value })
      if !isWide.value {
        Scrim(open: sidebarOpen.value).id("scrim")
      }
      VStack(alignment: .stretch, spacing: 0) {
        TitleBar()
        Content()
        StatusBar()
      }
      .id("main")
      .withProps({ id: "main", role: "main" })
      .style({ flex: "1", minWidth: "0", height: "100%" })
      if !isDesktop.value {
        InspectorScrim(open: inspectorOpen.value).id("inspector-scrim")
      }
      Element("div", {}) {
        if inspectorOpen.value {
          WorkspacePanel()
            .id("workspace-panel")
            .transition(Transition.move("trailing", 336))
        }
      }.withProps({ className: "pane-slot pane-slot--trailing", "data-open": inspectorOpen.value && isDesktop.value })
      if sheet.value !== "none" {
        SheetLayer().id("sheet")
      }
      if toast.value {
        Toast().id("toast")
      }
    }
    .background(color.bg)
    .foregroundStyle(color.text)
    .style({ width: "100%", height: "var(--app-height, 100dvh)", overflow: "hidden" })
  }
}

struct App: View {
  var body: some View {
    Group() {
      if connection.value === "auth-required" || location.pathname === "/enroll" {
        AuthView()
      } else {
        Shell()
      }
    }
  }
}

export default App()
