import { Transition } from "@mun/core"
import { color } from "./theme"
import { connection, page, sheet, sidebarOpen, inspectorOpen, isWide, isDesktop, toast } from "./state"
import { AuthView } from "./Auth.mun"
import { Sidebar, Scrim } from "./Sidebar.mun"
import { WorkspacePanel, InspectorScrim } from "./Inspector.mun"
import { TopBar, Chat } from "./Chat.mun"
import { FilesPage, DiffPage } from "./Pages.mun"
import { AgentsPage } from "./Agents.mun"
import { TasksPage } from "./Tasks.mun"
import { DebatePage, ExtensionsPage } from "./Debate.mun"
import { SheetLayer } from "./Sheets.mun"

struct Content: View {
  var body: some View {
    Group() {
      if page.value === "files" {
        FilesPage()
      } else if page.value === "diff" {
        DiffPage()
      } else if page.value === "agents" {
        AgentsPage()
      } else if page.value === "tasks" {
        TasksPage()
      } else if page.value === "debate" {
        DebatePage()
      } else if page.value === "extensions" {
        ExtensionsPage()
      } else {
        Chat()
      }
    }
  }
}

struct Toast: View {
  var body: some View {
    Text(toast.value)
      .withProps({ role: "status" })
      .fontSize(13)
      .padding({ top: 8, bottom: 8, leading: 14, trailing: 14 })
      .background(color.accent)
      .foregroundStyle(color.accentInk)
      .style({ position: "fixed", bottom: "96px", left: "50%", translate: "-50% 0", borderRadius: "8px", zIndex: "30" })
      .transition(Transition.opacity.combined(Transition.move("bottom", 10)))
  }
}

struct Shell: View {
  var body: some View {
    HStack(alignment: .stretch, spacing: 0) {
      if sidebarOpen.value {
        Sidebar()
          .id("sidebar")
          .transition(Transition.opacity.combined(Transition.move("leading", 24)))
      }
      if sidebarOpen.value && !isWide.value {
        Scrim().id("scrim")
      }
      VStack(alignment: .stretch, spacing: 0) {
        TopBar()
        Content()
      }
      .id("main")
      .withProps({ id: "main", role: "main" })
      .style({ flex: "1", minWidth: "0", height: "100%" })
      if inspectorOpen.value && !isDesktop.value {
        InspectorScrim().id("inspector-scrim")
      }
      if inspectorOpen.value {
        WorkspacePanel()
          .id("workspace-panel")
          .transition(Transition.opacity.combined(Transition.move("trailing", 24)))
      }
      if sheet.value !== "none" {
        SheetLayer().id("sheet")
      }
      if toast.value {
        Toast().id("toast")
      }
    }
    .background(color.bg)
    .foregroundStyle(color.text)
    .style({ width: "100%", height: "var(--app-height, 100dvh)", overflow: "hidden" })
  }
}

struct App: View {
  var body: some View {
    Group() {
      if connection.value === "auth-required" || location.pathname === "/enroll" {
        AuthView()
      } else {
        Shell()
      }
    }
  }
}

export default App()
