import { Icon, Transition, withAnimation } from "@mun/core"
import { workIcon } from "./workIcons"
import { remoteStore } from "@/store/remoteStore"
import { color, mono } from "./theme"
import {
  remote, ease, isWide, sidebarOpen, page, connected, toggleSidebar, openSheet, contextLabel, shortModel,
  toolbarControl, conversationRef, workspaceLine, elapsed, inspectorOpen, toggleInspector,
  showJumpToLatest, jumpToLatest,
} from "./state"
import {
  text, attachments, canAttach, setText, primary, primaryEnabled, cancelEdit, chooseSuggestion, suggestions, onKeyDown,
  removeAttachment, pickFiles, addFiles,
} from "./composer"
import { Spinner, PageHeader, Chip, IconButton } from "./Common.mun"
import { ToolDetails } from "./ToolDetails.mun"

const questionAnswer = State("")

function answerQuestion(question: any, answer: string | null) {
  remoteStore.sendComposerUi({ type: "answer_question", value: { id: question.id, answer } })
  questionAnswer.value = ""
}

function submitCustomAnswer(question: any) {
  const value = questionAnswer.value.trim()
  if (value) answerQuestion(question, value)
}

function connectionLabel(): string {
  switch (remote.value.connection) {
    case "connected": return ""
    case "failed": return remote.value.connectionError || "Connection failed"
    case "offline": return "Offline"
    case "reconnecting": return "Reconnecting…"
    default: return "Connecting…"
  }
}

/** Stable shell controls stay available on every page and viewport. */
export struct TopBar: View {
  var body: some View {
    HStack(spacing: 10) {
      if !sidebarOpen.value {
        IconButton(icon: "sidebar", label: "Toggle sidebar", action: { toggleSidebar(true) })
          .withProps({ "aria-controls": "sidebar", "aria-expanded": sidebarOpen.value })
          .transition(Transition.opacity)
      }
      Text(page.value === "chat" ? remote.value.currentSession?.title || "New session" : page.value === "files" ? "Files" : page.value === "diff" ? "Review changes" : page.value === "tasks" ? "Scheduled tasks" : page.value === "debate" ? "Debate" : page.value === "extensions" ? "Extensions" : "Agents")
        .fontSize(14).fontWeight("medium").lineLimit(1)
        .style({ minWidth: "0" })
      Spacer()
      Text(connectionLabel())
        .fontSize(12)
        .foregroundStyle(remote.value.connection === "failed" ? color.del : color.faint)
        .withProps({ role: "status", className: "connection-label" })
      IconButton(icon: "inspector", label: "Toggle workspace panel", action: { toggleInspector() })
        .withProps({ "aria-controls": "workspace-panel", "aria-expanded": inspectorOpen.value, "aria-keyshortcuts": "Control+Shift+B Meta+Shift+B" })
    }
    .withProps({ className: "topbar" })
  }
}

function rawTraceLabel(trace: Any): string {
  return trace.summary && trace.summary !== trace.title ? trace.title + " · " + trace.summary : trace.title
}

/** Some providers expose only a count and a generic phase (e.g. "6 · Running").
 * Neither is a useful work description; never present them as an action. */
function isOpaqueWorkLabel(label: string): boolean {
  const parts = (label || "").trim().split(/\s*(?:[·•]|\.)\s*/).filter(Boolean)
  return !parts.length || parts.every(part => /^(?:\d+(?:\s+(?:actions?|activities|tools?|calls?|events?))?|running|working|preparing|pending|in progress)$/i.test(part.trim()))
}

function traceLabel(trace: Any): string {
  const label = rawTraceLabel(trace)
  return isOpaqueWorkLabel(label) ? "Working" : label
}

function traceStatus(trace: Any): string {
  return /permission|approv|fail|error|denied|timed|cancel|interrupt/i.test(trace.status_label || "") ? trace.status_label : ""
}

function traceContext(trace: Any): string {
  return !isOpaqueWorkLabel(rawTraceLabel(trace)) && trace.summary !== trace.title ? trace.summary || "" : ""
}

function hasTraceDetails(trace: Any): boolean {
  return !!(trace.details.length || trace.metadata || trace.rich?.length)
}

function traceRegion(id: string): string {
  return "trace-details-" + encodeURIComponent(id)
}

/** Work content is visible inline, with its tool or reasoning icon. */
struct TraceLabel: View {
  let trace: Any
  let groupHeader: Bool
  let disclosure: Bool
  var body: some View {
    HStack(spacing: 6) {
      // Stroke geometry goes through CSS: Mün writes SVG attributes in camelCase, which browsers ignore.
      Icon(workIcon(trace.icon), { viewBox: "0 0 24 24", fill: "none", stroke: "currentColor" })
        .frame(width: 14, height: 14)
        .foregroundStyle(color.faint)
        .withProps({ "aria-hidden": "true", className: "trace-disclosure__icon" })
        .style({ flex: "none", strokeWidth: "1.8px", strokeLinecap: "round", strokeLinejoin: "round" })
      VStack(alignment: .stretch, spacing: 2) {
        HStack(spacing: 6) {
          Text(isOpaqueWorkLabel(rawTraceLabel(trace)) ? "Working" : trace.title)
            .withProps({ className: "trace-disclosure__title" })
          if traceContext(trace) !== "" {
            Text(traceContext(trace)).withProps({ className: "trace-disclosure__context" })
          }
        }.withProps({ className: "trace-disclosure__caption" })
        if traceStatus(trace) !== "" {
          Text(traceStatus(trace))
            .foregroundStyle(/approv|permission/i.test(traceStatus(trace)) ? color.text2 : color.del)
            .withProps({ className: "trace-disclosure__status" })
        }
      }
      .withProps({ className: groupHeader ? (trace.active ? "trace-disclosure__label activity-group__summary is-active" : "trace-disclosure__label activity-group__summary") : "trace-disclosure__label", title: traceLabel(trace) })
      if trace.stepCount > 1 {
        Text(trace.stepCount + " steps").withProps({ className: "activity-group__count" })
      }
      if trace.active && /approv|permission/i.test(traceStatus(trace)) === false {
        Spinner().withProps({ role: "img", "aria-label": "Running" })
      }
      if disclosure {
        Icon(workIcon("chevron"), { viewBox: "0 0 24 24", fill: "none", stroke: "currentColor" })
          .withProps({ className: "trace-disclosure__chevron", "aria-hidden": "true" })
      }
    }
    .withProps({ className: "trace-disclosure__summary" })
    .style({ minWidth: "0", width: "100%" })
  }
}

struct Trace: View {
  let trace: Any
  let groupHeader: Bool
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      if hasTraceDetails(trace) === true {
        Button(action: { remoteStore.sendConversationUi({ type: "toggle", value: trace.id }) }, label: {
          TraceLabel(trace: trace, groupHeader: groupHeader, disclosure: true)
        })
        .withProps({ className: groupHeader ? "trace-disclosure__row activity-group__header" : "trace-disclosure__row", "aria-expanded": trace.expanded, "aria-controls": traceRegion(trace.id) })
      } else {
        TraceLabel(trace: trace, groupHeader: groupHeader, disclosure: false)
          .withProps({ className: groupHeader ? "trace-disclosure__row activity-group__header" : "trace-disclosure__row" })
      }
      if trace.expanded {
        VStack(alignment: .stretch, spacing: 10) {
          ToolDetails(trace: trace)
          if trace.metadata {
            Text("Duration: " + trace.metadata).withProps({ className: "trace-disclosure__timing" })
          }
        }
        .withProps({ className: "trace-disclosure__details", id: traceRegion(trace.id), role: "region", "aria-label": traceLabel(trace) + " details" })
        .transition(Transition.opacity.combined(Transition.move("top", 4)))
      }
    }
    .withProps({ className: "trace-disclosure" })
  }
}

/** Provider narration is intentionally not a disclosure or a tool record. */
struct Reasoning: View {
  let trace: Any
  var body: some View {
    Element("yeet-markdown", { source: trace.summary || "" })
      .fontSize(13)
      .foregroundStyle(trace.active ? color.muted : color.faint)
      .style({ whiteSpace: "pre-wrap", overflowWrap: "anywhere", lineHeight: "1.65" })
      .padding({ top: 8, bottom: 12, leading: 0 })
  }
}

function singleTrace(group: Any): Any {
  const trace = group.events[0].trace
  return { ...trace, raw_id: "raw:" + trace.id, id: group.id, expanded: group.expanded }
}

function groupTrace(group: Any): Any {
  const events = group.events || []
  const reversed = [...events].reverse()
  // Keep the backend's semantic summary where possible. If it is only a count
  // and a phase, surface the latest actual action from the same group instead.
  const opaque = isOpaqueWorkLabel(group.summary || "")
  const preferred = opaque
    ? (reversed.find(event => event.type !== "activity" && !isOpaqueWorkLabel(rawTraceLabel(event.trace)))
      || reversed.find(event => !isOpaqueWorkLabel(rawTraceLabel(event.trace))))
    : reversed.find(event => rawTraceLabel(event.trace) === group.summary)
  return {
    title: preferred ? preferred.trace.title : opaque ? "Working" : group.summary,
    summary: preferred ? preferred.trace.summary : null,
    details: [],
    icon: preferred?.trace.icon || events[events.length - 1]?.trace.icon,
    active: group.active,
    status_label: group.status_label,
    stepCount: events.length,
  }
}

struct Activity: View {
  let group: Any
  var body: some View {
    Group() {
      if group.events.length === 1 {
        Trace(trace: singleTrace(group), groupHeader: true)
      } else {
        VStack(alignment: .stretch, spacing: 4) {
          Button(action: { remoteStore.sendConversationUi({ type: "toggle", value: group.id }) }, label: {
            TraceLabel(trace: groupTrace(group), groupHeader: true, disclosure: true)
          })
          .withProps({ className: "activity-group__header", "aria-expanded": group.expanded, "aria-controls": traceRegion(group.id) })
          if group.expanded {
            VStack(alignment: .stretch, spacing: 4) {
              ForEach(group.events, { id: event => event.key }) { event in
                Trace(trace: event.trace, groupHeader: false)
                  .withProps({ className: "activity-group__event" })
              }
            }
            .withProps({ className: "activity-group__events", id: traceRegion(group.id), role: "group", "aria-label": "Tool steps" })
            .transition(Transition.opacity.combined(Transition.move("top", 4)))
          }
        }
      }
    }
  }
}

struct MessageControls: View {
  let controls: Any
  let trailing: Bool
  var body: some View {
    HStack(spacing: 2) {
      if trailing {
        Spacer()
      }
      ForEach(controls, { id: control => control.action.type }) { control in
        Chip(title: control.label.replace(" message", "").replace(" response", ""), action: { remoteStore.sendConversationUi(control.action) })
          .accessibilityLabel(control.label)
          .disabled(!control.enabled)
      }
      if !trailing {
        Spacer()
      }
    }
    .withProps({ className: "message-actions" })
  }
}

struct Message: View {
  let item: Any
  @State var hovering: Bool = false
  var body: some View {
    VStack(alignment: .stretch, spacing: 4) {
      if item.entry.kind.type === "user" {
        Element("yeet-markdown", { source: item.prompt && !item.prompt.expanded ? item.prompt.preview : item.entry.kind.content })
          .padding({ top: 12, bottom: 12, leading: 16, trailing: 16 })
          .background(color.bubble)
          .withProps({ className: "user-message" })
      } else if item.entry.kind.type === "assistant" {
        Element("yeet-markdown", { source: item.entry.kind.content })
          .style({ width: "100%" })
      } else if item.entry.kind.type === "error" {
        Text(item.entry.kind.content).foregroundStyle(color.del)
      } else {
        Text(item.entry.kind.content || item.entry.kind.name || "")
          .fontSize(13)
          .foregroundStyle(color.faint)
      }
      if item.prompt {
        Chip(title: item.prompt.expanded ? "Show less" : "Show full prompt", action: { remoteStore.sendConversationUi({ type: "toggle", value: item.id }) })
          .accessibilityLabel(item.prompt.expanded ? "Collapse prompt" : "Expand prompt")
      }
      MessageControls(controls: item.controls, trailing: item.entry.kind.type === "user")
        .opacity(hovering.value || !isWide.value ? 1 : 0)
        .animation(ease, value: hovering.value)
    }
    .style({ alignItems: item.entry.kind.type === "user" ? "flex-end" : "stretch" })
    .onHover(inside => { hovering.value = inside })
  }
}

function itemSpacing(item: Any): string {
  const items = remote.value.conversation?.items ?? []
  const index = items.findIndex(candidate => candidate.id === item.id)
  if (index <= 0) return "0"
  const previous = items[index - 1]
  return item.type !== "entry" && previous.type !== "entry" ? "0" : "24px"
}

function showWorking(): boolean {
  const view = remote.value.conversation
  return !!view?.preparing || !!(remote.value.state.is_streaming && !view?.streaming_text && !view?.items.some(item =>
    item.type === "activity" ? item.group.active || item.group.awaits_permission : item.type === "reasoning" && item.trace.active))
}

struct Item: View {
  let item: Any
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      if item.type === "activity" {
        Activity(group: item.group)
      } else if item.type === "reasoning" {
        Reasoning(trace: item.trace)
      } else {
        Message(item: item)
      }
    }
    .withProps({ className: item.type === "activity" ? "activity-group" : item.type === "reasoning" ? "reasoning-trace" : "message-block message-block--" + item.entry.kind.type })
    .style({ minWidth: "0", marginTop: itemSpacing(item) })
  }
}

/** Working status in the TUI's shape: `/ label · 18s`. */
struct Working: View {
  var body: some View {
    HStack(spacing: 8) {
      Spinner()
      Text([remote.value.conversation?.preparing_label || "Working", elapsed()].filter(Boolean).join(" · "))
        .fontSize(13)
        .foregroundStyle(color.faint)
      Spacer()
    }
    .transition(Transition.opacity)
  }
}

struct EmptyState: View {
  var body: some View {
    VStack(alignment: .center, spacing: 6) {
      Image("/yeet-mark.svg").style({ width: "44px", height: "44px", marginBottom: "12px" })
      Text(connected() ? "What should we work on?" : "Waiting for Yeet…").fontSize(30).fontWeight("medium")
      Text(workspaceLine()).fontSize(13).foregroundStyle(color.faint)
    }
    .withProps({ className: "empty-conversation" })
    .style({ flex: "1", width: "100%", justifyContent: "center", minHeight: "0", textAlign: "center" })
    .transition(Transition.opacity)
  }
}

function hasConversation(): boolean {
  return !!(remote.value.conversation?.items.length || remote.value.conversation?.streaming_text)
}

struct Thread: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      if hasConversation() === true {
        ForEach(remote.value.conversation?.items ?? [], { id: item => item.id }) { item in
          Item(item: item)
        }
        if remote.value.conversation?.streaming_text {
          Element("yeet-markdown", { source: remote.value.conversation.streaming_text })
            .style({ width: "100%", marginTop: "24px" })
        }
      } else {
        EmptyState()
      }
      if showWorking() === true {
        Working().padding({ top: 12 })
      }
      if remote.value.conversation?.error {
        Text(remote.value.conversation.error).foregroundStyle(color.del).padding({ top: 12 })
      }
    }
    .padding({ top: 32, bottom: 32, leading: 24, trailing: 24 })
    .withProps({ className: "conversation-content" })
    .style({ maxWidth: "var(--thread-width)", margin: "0 auto", minHeight: "100%", width: "100%" })
  }
}

struct Permission: View {
  let request: Any
  var body: some View {
    VStack(alignment: .stretch, spacing: 8) {
      Text(request.title).fontSize(14).fontWeight("medium")
      Text(request.operation || request.detail)
        .fontSize(13)
        .foregroundStyle(color.muted)
        .style({ fontFamily: mono, whiteSpace: "pre-wrap" })
      if request.reason {
        Text(request.reason).fontSize(13).foregroundStyle(color.muted)
      }
      HStack(spacing: 8) {
        Spacer()
        ForEach(request.controls, { id: control => control.label }) { control in
          Button(control.label) { remoteStore.sendComposerUi(control.action) }
            .fontSize(14)
            .fontWeight("medium")
            .padding({ top: 7, bottom: 7, leading: 14, trailing: 14 })
            .background(control.icon === "allow" ? color.accent : color.raised)
            .foregroundStyle(control.icon === "allow" ? color.accentInk : color.text)
            .style({ borderRadius: "10px" })
            .disabled(!control.enabled || !connected())
        }
      }
    }
    .padding(14)
    .background(color.panel)
    .style({ borderRadius: "14px" })
    .transition(Transition.opacity.combined(Transition.move("bottom", 8)))
  }
}

/** Main-agent question: suggested answers plus an optional typed answer. */
struct Question: View {
  let question: Any
  var body: some View {
    VStack(alignment: .stretch, spacing: 8) {
      Text("Question from agent").fontSize(12).foregroundStyle(color.faint)
      Text(question.question).fontSize(14).fontWeight("medium").style({ whiteSpace: "pre-wrap" })
      VStack(alignment: .stretch, spacing: 6) {
        ForEach(question.options, { id: option => option }) { option in
          Button(option) { answerQuestion(question, option) }
            .fontSize(14)
            .padding({ top: 8, bottom: 8, leading: 14, trailing: 14 })
            .background(color.raised)
            .foregroundStyle(color.text)
            .style({ borderRadius: "10px", textAlign: "left" })
            .disabled(!question.enabled || !connected())
        }
      }
      if question.allow_custom {
        HStack(spacing: 8) {
          TextField(Binding(questionAnswer), "Type your own answer")
            .accessibilityLabel("Custom answer")
            .withProps({ onKeyDown: event => { if (event.key === "Enter") submitCustomAnswer(question) } })
            .fontSize(14)
            .padding({ top: 8, bottom: 8, leading: 12, trailing: 12 })
            .background(color.composer)
            .style({ flex: "1", minWidth: "0", border: "0", outline: "none", borderRadius: "10px", color: "inherit" })
          Button("Answer") { submitCustomAnswer(question) }
            .fontSize(14)
            .fontWeight("medium")
            .padding({ top: 7, bottom: 7, leading: 14, trailing: 14 })
            .background(color.accent)
            .foregroundStyle(color.accentInk)
            .style({ borderRadius: "10px" })
            .disabled(!question.enabled || !connected() || !questionAnswer.value.trim())
        }
      }
      HStack(spacing: 8) {
        Spacer()
        Button("Dismiss") { answerQuestion(question, null) }
          .fontSize(13)
          .foregroundStyle(color.muted)
          .disabled(!question.enabled || !connected())
      }
    }
    .padding(14)
    .background(color.panel)
    .style({ borderRadius: "14px" })
    .transition(Transition.opacity.combined(Transition.move("bottom", 8)))
  }
}

struct Suggestions: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      ForEach(suggestions(), { id: item => item.command }) { item in
        Button(action: { chooseSuggestion(item) }, label: {
          HStack(spacing: 12) {
            Text(item.command).fontSize(13).style({ fontFamily: mono })
            Text(item.description).fontSize(13).foregroundStyle(color.faint).lineLimit(1)
            Spacer()
          }
        })
        .padding({ top: 7, bottom: 7, leading: 14, trailing: 14 })
      }
    }
    .padding({ top: 6, bottom: 6 })
    .background(color.panel)
    .style({ borderRadius: "14px" })
    .transition(Transition.opacity.combined(Transition.move("bottom", 6)))
  }
}

struct AttachmentStrip: View {
  var body: some View {
    HStack(spacing: 6) {
      ForEach(attachments.value, { id: item => item.id }) { item in
        HStack(spacing: 6) {
          Text(item.name).fontSize(13).lineLimit(1)
          Text(item.error ? "failed" : item.remoteId ? "" : "uploading…").fontSize(12).foregroundStyle(item.error ? color.del : color.faint)
          Button("×") { removeAttachment(item.id) }.foregroundStyle(color.faint)
        }
        .padding({ top: 4, bottom: 4, leading: 10, trailing: 8 })
        .background(color.raised)
        .style({ borderRadius: "8px", maxWidth: "240px" })
        .transition(Transition.scale(0.9).combined(Transition.opacity))
      }
      Spacer()
    }
    .style({ flexWrap: "wrap" })
  }
}

struct ToolbarChoice: View {
  let id: String
  var body: some View {
    Group() {
      if toolbarControl(id) !== null {
        Picker(Binding(() => toolbarControl(id).value, value => remoteStore.sendToolbarUi({ type: "choose", value: { id, value } })),
             toolbarControl(id).options.map(option => ({ value: option.value, label: option.label })))
        .accessibilityLabel(toolbarControl(id).label)
        .fontSize(13)
        .foregroundStyle(color.faint)
        .disabled(!connected() || !toolbarControl(id).enabled)
        .style({ background: "transparent", border: "0", maxWidth: "160px" })
      }
    }
  }
}

/** Rounded composer: message field above a quiet control row. */
struct Composer: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 8) {
      ForEach(remote.value.composer?.permissions ?? [], { id: request => request.target.kind + ":" + request.target.id }) { request in
        Permission(request: request)
      }
      if remote.value.composer?.question {
        Question(question: remote.value.composer.question)
      }
      if suggestions().length {
        Suggestions()
      }
      if remote.value.composer?.edit_banner {
        HStack(spacing: 8) {
          Text(remote.value.composer.edit_banner).fontSize(13).foregroundStyle(color.faint)
          Spacer()
          Chip(title: "Cancel", action: { cancelEdit() })
        }
        .padding({ leading: 4 })
        .transition(Transition.opacity)
      }
      VStack(alignment: .stretch, spacing: 8) {
        if attachments.value.length {
          AttachmentStrip()
        }
        TextEditor(Binding(() => text.value, setText), remote.value.composer?.placeholder || "Ask anything about your code", 1)
          .accessibilityLabel("Message")
          .withProps({
            onKeyDown,
            onPaste: event => { if (canAttach.value && event.clipboardData?.files.length) { event.preventDefault(); addFiles(event.clipboardData.files) } },
          })
          .fontSize(16)
          .style({ width: "100%", minHeight: "26px", border: "0", outline: "none", background: "transparent", resize: "none", fieldSizing: "content", maxHeight: "40vh", color: "inherit", padding: "0" })
        HStack(spacing: 4) {
          if canAttach.value {
            IconButton(icon: "plus", label: "Attach files", action: { pickFiles() })
              .disabled(!connected() || remote.value.state.is_streaming)
          }
          Button(action: { openSheet("model") }, label: {
            HStack(spacing: 4) {
              Text(shortModel(remote.value.state.active_model) || "Model").lineLimit(1).style({ minWidth: "0" })
              Icon(workIcon("chevron"), { width: 12, height: 12 }).style({ transform: "rotate(90deg)" })
            }
          }).withProps({ className: "model-trigger", "aria-label": "Choose model", title: remote.value.state.active_model || "Choose model" }).disabled(!connected())
          ToolbarChoice(id: "reasoning")
          Spacer()
          Button(action: { primary() }, label: {
            if remote.value.state.is_streaming {
              RoundedRectangle(3).style({ width: "12px", height: "12px", background: "currentColor" })
            } else {
              Icon(workIcon("arrow"), { width: 19, height: 19, strokeWidth: 2 })
            }
          })
            .accessibilityLabel(remote.value.composer?.primary_control.label || "Send")
            .withProps({ className: "send-button", title: remote.value.state.is_streaming ? "Stop generating" : "Send message" })
            .background(remote.value.state.is_streaming ? color.raised : color.accent)
            .foregroundStyle(remote.value.state.is_streaming ? color.text : color.accentInk)
            .opacity(primaryEnabled() ? 1 : 0.35)
            .animation(ease, value: remote.value.state.is_streaming)
            .disabled(!primaryEnabled())
        }.withProps({ className: "composer-controls" })
      }
      .padding({ top: 14, bottom: 10, leading: 16, trailing: 10 })
      .background(color.composer)
      .withProps({ className: "composer-surface" })
      .style({ width: "100%", minWidth: "0" })
      Text("Enter to send · Shift + Enter for a new line").withProps({ className: "composer-hint" })
    }
    .padding({ top: 4, bottom: 16, leading: 16, trailing: 16 })
    .withProps({ className: "composer" })
    .style({ maxWidth: "calc(var(--thread-width) + 16px)", margin: "0 auto", width: "100%" })
  }
}

export struct Chat: View {
  var body: some View {
    VStack(alignment: .stretch, spacing: 0) {
      ScrollView() {
        Thread()
      }
      .withProps({ className: "thread-scroll", role: "region", "aria-label": "Conversation", tabindex: "0", ref: conversationRef })
      .style({ flex: "1", minHeight: "0", width: "100%" })
      if showJumpToLatest.value {
        HStack(spacing: 0) {
          Spacer()
          Button(action: { jumpToLatest() }, label: {
            HStack(spacing: 6) {
              Icon(workIcon("arrow"), { width: 14, height: 14 }).rotationEffect(180)
              Text("Jump to latest").fontSize(12)
            }
          })
          .withProps({ className: "jump-to-latest" })
          Spacer()
        }
        .withProps({ className: "jump-latest-anchor" })
        .transition(Transition.opacity.combined(Transition.move("bottom", 4)))
      }
      Composer()
    }
    .style({ flex: "1", minHeight: "0" })
  }
}
